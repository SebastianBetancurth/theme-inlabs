{% comment %}
  BLOQUE: zzen_badge — etiqueta tipo "Bestseller"
  Parámetros: block, product, section
{% endcomment %}

{%- liquid
  assign b = block.settings

  if b.layout_mobile == 'auto'
    assign flex_mobile = '0 0 auto'
  else
    assign flex_mobile = '0 0 100%'
  endif

  if b.layout_desktop == 'auto'
    assign flex_desktop = '0 0 auto'
  else
    assign flex_desktop = '0 0 100%'
  endif
-%}

{%- style -%}
  /* ---- Layout dentro del hero-header ---- */
  @media screen and (max-width: 749px) {
    .product__hero-header > .zzen-badge-{{ block.id }} {
      flex: {{ flex_mobile }};
      order: {{ b.order_mobile | default: 3 }};
      {% if b.push_right_mobile %}margin-left: auto;{% endif %}
      align-self: {{ b.align_self_mobile | default: 'flex-start' }};
      margin-top: -20px;
    }
  }

  @media screen and (min-width: 750px) {
    .product__hero-header > .zzen-badge-{{ block.id }} {
      flex: {{ flex_desktop }};
      order: {{ b.order_desktop | default: 2 }};
      {% if b.push_right_desktop %}margin-left: auto;{% endif %}
      align-self: {{ b.align_self_desktop | default: 'auto' }};
      margin-top: {{ b.offset_top_desktop | default: 0 }}px;
    }
  }

  /* ---- Estilos propios ---- */
  .zzen-badge-{{ block.id }} {
    display: flex;
    justify-content: {{ b.align_mobile }};
    margin-bottom: {{ b.margin_bottom_mobile }}px;
  }

  .zzen-badge-{{ block.id }}__pill {
    display: inline-flex;
    align-items: center;
    gap: {{ b.gap_icon_text }}px;
    background-color: {{ b.bg_color }};
    border: {{ b.border_width }}px solid {{ b.border_color }};
    border-radius: {{ b.border_radius }}px;
    padding: {{ b.padding_y_mobile }}px {{ b.padding_x_mobile }}px;
    text-decoration: none;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .zzen-badge-{{ block.id }}__icon {
    display: block;
    flex: 0 0 auto;
    width: {{ b.icon_size_mobile }}px;
    height: {{ b.icon_size_mobile }}px;
    color: {{ b.icon_color }};
  }

  .zzen-badge-{{ block.id }}__icon svg,
  .zzen-badge-{{ block.id }}__icon img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .zzen-badge-{{ block.id }}__icon img { object-fit: contain; }

  .zzen-badge-{{ block.id }}__text {
    font-family: {% if b.use_theme_font %}var(--font-body-family){% else %}{{ b.custom_font_stack }}{% endif %};
    font-style: normal;
    color: {{ b.text_color }};
    font-size: {{ b.text_size_mobile }}px;
    font-weight: {{ b.text_weight }};
    letter-spacing: {{ b.letter_spacing }}px;
    line-height: 1.2;
    {% if b.uppercase %}text-transform: uppercase;{% endif %}
  }

  {% if b.show_mobile == false %}
    .zzen-badge-{{ block.id }} { display: none; }
  {% endif %}

  @media screen and (min-width: 750px) {
    .zzen-badge-{{ block.id }} {
      justify-content: {{ b.align_desktop }};
      margin-bottom: {{ b.margin_bottom_desktop }}px;
      {% if b.show_mobile == false and b.show_desktop %}display: flex;{% endif %}
      {% if b.show_desktop == false %}display: none;{% endif %}
    }
    .zzen-badge-{{ block.id }}__pill {
      padding: {{ b.padding_y_desktop }}px {{ b.padding_x_desktop }}px;
    }
    .zzen-badge-{{ block.id }}__icon {
      width: {{ b.icon_size_desktop }}px;
      height: {{ b.icon_size_desktop }}px;
    }
    .zzen-badge-{{ block.id }}__text {
      font-size: {{ b.text_size_desktop }}px;
    }
  }
{%- endstyle -%}

{%- capture badge_icon -%}
  {%- if b.icon_image != blank -%}
    <span class="zzen-badge-{{ block.id }}__icon">
      {{ b.icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
    </span>
  {%- elsif b.icon_style != 'none' -%}
    <span class="zzen-badge-{{ block.id }}__icon" aria-hidden="true">
      {%- if b.icon_style == 'check_circle' -%}
       <svg class="product-info__badge-icon product-info__badge-icon--desktop" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M15 8L9.5 14L7 11.2727" stroke="black" stroke-width="1.2" stroke-linecap="square"></path>
        <path d="M8.2019 19.6009C8.52965 19.5575 8.86073 19.6464 9.12182 19.8475L10.3251 20.7708C10.7228 21.0764 11.2761 21.0764 11.6727 20.7708L12.9215 19.812C13.1548 19.6331 13.4492 19.5542 13.7403 19.5931L15.3024 19.7986C15.799 19.8642 16.2779 19.5875 16.4701 19.1242L17.0712 17.6709C17.1834 17.3987 17.3989 17.1832 17.6711 17.0709L19.1243 16.4698C19.5876 16.2787 19.8643 15.7988 19.7987 15.3021L19.601 13.7966C19.5576 13.4688 19.6465 13.1377 19.8476 12.8766L20.7709 11.6733C21.0764 11.2755 21.0764 10.7222 20.7709 10.3256L19.812 9.07672C19.6332 8.84339 19.5543 8.54896 19.5932 8.25785L19.7987 6.69568C19.8643 6.19902 19.5876 5.72015 19.1243 5.52793L17.6711 4.92684C17.3989 4.81462 17.1834 4.59907 17.0712 4.32685L16.4701 2.87356C16.279 2.41024 15.799 2.13358 15.3024 2.19913L13.7403 2.40468C13.4492 2.44468 13.1548 2.36579 12.9226 2.18802L11.6738 1.22916C11.2761 0.923613 10.7228 0.923613 10.3262 1.22916L9.07738 2.18802C8.84407 2.36579 8.54965 2.44468 8.25856 2.40691L6.69647 2.20136C6.19984 2.1358 5.721 2.41246 5.52879 2.87578L4.92884 4.32907C4.81552 4.60018 4.59998 4.81573 4.32889 4.92906L2.87568 5.52904C2.41238 5.72126 2.13574 6.20013 2.20129 6.69679L2.40683 8.25897C2.4446 8.55007 2.36572 8.8445 2.18796 9.07672L1.22915 10.3256C0.923617 10.7233 0.923617 11.2767 1.22915 11.6733L2.18796 12.9222C2.36683 13.1555 2.44571 13.4499 2.40683 13.741L2.20129 15.3032C2.13574 15.7999 2.41238 16.2787 2.87568 16.471L4.32889 17.0721C4.60109 17.1843 4.81663 17.3998 4.92884 17.672L5.5299 19.1253C5.721 19.5887 6.20096 19.8653 6.69758 19.7998L8.2019 19.6009Z" stroke="black" stroke-width="1.2" stroke-linecap="square"></path>
    </svg>
      {%- elsif b.icon_style == 'check' -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <path d="M4.5 12.5l5 5L19.5 7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {%- elsif b.icon_style == 'star' -%}
        <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <path d="M12 1.6l3.09 6.7 7.31.86-5.35 5.06 1.4 7.18L12 17.9l-6.45 3.5 1.4-7.18L1.6 9.16l7.31-.86L12 1.6z"/>
        </svg>
      {%- elsif b.icon_style == 'fire' -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <path d="M12 2.5c2.6 3.2 1.2 5.1.3 6.2-.6.8-.3 2 .8 2.2 1.4.3 2.2-1 2.3-2.3 1.8 1.7 2.8 3.7 2.8 5.9a6.2 6.2 0 1 1-12.4 0c0-4.6 3.6-6.7 4.9-9.4.5-1 .8-1.9 1.3-2.6z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {%- endif -%}
    </span>
  {%- endif -%}
{%- endcapture -%}

<div class="zzen-badge zzen-badge-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if b.link != blank -%}
    <a href="{{ b.link }}" class="zzen-badge-{{ block.id }}__pill">
      {{ badge_icon }}
      <span class="zzen-badge-{{ block.id }}__text">{{ b.text }}</span>
    </a>
  {%- else -%}
    <span class="zzen-badge-{{ block.id }}__pill">
      {{ badge_icon }}
      <span class="zzen-badge-{{ block.id }}__text">{{ b.text }}</span>
    </span>
  {%- endif -%}
</div>
