        margin-top: {{ b.margin_top_desktop }}px;
        margin-bottom: {{ b.margin_bottom_desktop }}px;
        {% if b.show_mobile == false and b.show_desktop %}display: block;{% endif %}
        {% if b.show_desktop == false %}display: none;{% endif %}
      }

      .zzen-acc-{{ block.id }}__summary {
        gap: {{ b.left_icon_gap_desktop }}px;
        padding: {{ b.row_padding_y_desktop }}px 0;
      }

      .zzen-acc-{{ block.id }}__title { font-size: {{ b.title_size_desktop }}px; }

      .zzen-acc-{{ block.id }}__lead {
        width: {{ b.left_icon_size_desktop }}px;
        height: {{ b.left_icon_size_desktop }}px;
        transform: translateY({{ b.left_icon_offset_desktop }}px);
      }

      .zzen-acc-{{ block.id }}__caret {
        width: {{ b.caret_size_desktop }}px;
        height: {{ b.caret_size_desktop }}px;
        margin-left: {{ b.caret_gap_desktop }}px;
      }

      .zzen-acc-{{ block.id }}__inner {
        font-size: {{ b.content_size_desktop }}px;
        padding-bottom: {{ b.content_padding_bottom_desktop }}px;
        padding-left: {{ b.content_indent_desktop }}px;
        padding-right: {{ b.content_padding_right_desktop }}px;
      }
    }
  {%- endstyle -%}

  {%- comment -%} ---------- Icono izquierdo ---------- {%- endcomment -%}
  {%- capture lead_icon -%}
    {%- if b.left_icon_image != blank -%}
      <span class="zzen-acc-{{ block.id }}__lead">
        {{ b.left_icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
      </span>
    {%- elsif b.left_icon_style != 'none' -%}
      <span class="zzen-acc-{{ block.id }}__lead" aria-hidden="true">
        {%- if b.left_icon_style == 'arrow_up_right' -%}
          <svg viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <path d="M1 13.7827L13.6938 1.08887" stroke="currentColor" stroke-width="{{ b.left_icon_stroke }}" stroke-linecap="round"/>
            <path d="M13.7826 13.6051V1H1" stroke="currentColor" stroke-width="{{ b.left_icon_stroke }}" stroke-linecap="round"/>
          </svg>
        {%- elsif b.left_icon_style == 'arrow_right' -%}
          <svg viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <path d="M1 7.5h12.7" stroke="currentColor" stroke-width="{{ b.left_icon_stroke }}" stroke-linecap="round"/>
            <path d="M9.2 3l4.5 4.5-4.5 4.5" stroke="currentColor" stroke-width="{{ b.left_icon_stroke }}" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {%- elsif b.left_icon_style == 'plus' -%}
          <svg viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <path d="M7.5 1.5v12M1.5 7.5h12" stroke="currentColor" stroke-width="{{ b.left_icon_stroke }}" stroke-linecap="round"/>
          </svg>
        {%- elsif b.left_icon_style == 'dot' -%}
          <svg viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <circle cx="7.5" cy="7.5" r="3" fill="currentColor"/>
          </svg>
        {%- endif -%}
      </span>
    {%- endif -%}
  {%- endcapture -%}

  {%- comment -%} ---------- Icono indicador ---------- {%- endcomment -%}
  {%- capture caret_icon -%}
    {%- if b.caret_style != 'none' -%}
      <span class="zzen-acc-{{ block.id }}__caret" aria-hidden="true">
        {%- if b.caret_style == 'chevron_wide' -%}
          <svg viewBox="0 0 22 12" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <path d="M1 1l10 10L21 1" stroke="currentColor" stroke-width="{{ b.caret_stroke }}" stroke-linecap="round"/>
          </svg>
        {%- elsif b.caret_style == 'chevron' -%}
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <path d="M3 5.5l5 5 5-5" stroke="currentColor" stroke-width="{{ b.caret_stroke }}" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {%- elsif b.caret_style == 'plus' -%}
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="{{ b.caret_stroke }}" stroke-linecap="round"/>
          </svg>
        {%- elsif b.caret_style == 'arrow' -%}
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <path d="M8 2.5v11" stroke="currentColor" stroke-width="{{ b.caret_stroke }}" stroke-linecap="round"/>
            <path d="M3.5 9l4.5 4.5L12.5 9" stroke="currentColor" stroke-width="{{ b.caret_stroke }}" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        {%- endif -%}
      </span>
    {%- endif -%}
  {%- endcapture -%}

  <zzen-accordion
    class="zzen-acc zzen-acc-{{ block.id }}"
    data-duration="{{ b.duration }}"
    data-easing="{{ easing_css }}"
    data-exclusive="{{ b.exclusive }}"
    data-fade="{{ b.content_fade }}"
    data-slide="{{ b.content_slide }}"
    {{ block.shopify_attributes }}
  >
    {%- assign rendered = 0 -%}
    {%- for i in row_indexes -%}
      {%- liquid
        assign title_key = 'row_' | append: i | append: '_title'
        assign content_key = 'row_' | append: i | append: '_content'
        assign page_key = 'row_' | append: i | append: '_page'
        assign row_title = b[title_key]
        assign row_content = b[content_key]
        assign row_page = b[page_key]
      -%}

      {%- if row_title != blank -%}
        {%- assign rendered = rendered | plus: 1 -%}
        <details
          id="ZzenAcc-{{ block.id }}-{{ i }}"
          class="zzen-acc-{{ block.id }}__item"
          {% if b.open_first and rendered == 1 %}open{% endif %}
        >
          <summary class="zzen-acc-{{ block.id }}__summary">
            {%- if has_left_icon -%}{{ lead_icon }}{%- endif -%}
            <span class="zzen-acc-{{ block.id }}__title">{{ row_title }}</span>
            {{ caret_icon }}
          </summary>

          <div class="zzen-acc-{{ block.id }}__panel" data-zzen-acc-panel>
            <div class="zzen-acc-{{ block.id }}__inner rte" data-zzen-acc-inner>
              {{ row_content }}
              {{ row_page.content }}
            </div>
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </zzen-accordion>
{%- endif -%}
