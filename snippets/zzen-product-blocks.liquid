{% comment %}
  ============================================================
  SNIPPET: zzen-product-blocks.liquid
  ROUTER. Delega en un snippet por tipo de bloque.
  Se llama desde main-product.liquid (hero-header + info-container)

  Parámetros: block, product, section

  Para añadir un bloque nuevo:
    1. Crea snippets/zzen-block-XXXX.liquid
    2. Añade su "when" aquí
    3. Añade su tipo a la variable zzen_block_types en main-product.liquid
    4. Añade su definición al {% schema %} de main-product.liquid
  ============================================================
{% endcomment %}

{%- case block.type -%}

  {%- when 'zzen_rating' -%}
    {% render 'zzen-block-rating', block: block, product: product, section: section %}

  {%- when 'zzen_badge' -%}
    {% render 'zzen-block-badge', block: block, product: product, section: section %}

  {%- when 'zzen_title' -%}
    {% render 'zzen-block-title', block: block, product: product, section: section %}

  {%- when 'zzen_bullets' -%}
    {% render 'zzen-block-bullets', block: block, product: product, section: section %}

  {%- when 'zzen_cta' -%}
    {% render 'zzen-block-cta', block: block, product: product, section: section %}

  {%- when 'zzen_note' -%}
  {% render 'zzen-block-note', block: block, product: product, section: section %}

{%- endcase -%}
