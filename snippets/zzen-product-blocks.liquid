{% comment %}
  ============================================================
  SNIPPET: zzen-product-blocks.liquid
  Router de bloques personalizados de la product page.
  Se llama desde main-product.liquid (hero-header + info-container)

  Parámetros:
    block   -> el bloque de la sección
    product -> objeto producto
    section -> objeto sección

  Tipos soportados:
    - zzen_rating  (estrellas + texto de valoración)
    - zzen_badge   (etiqueta tipo "Bestseller")
  ============================================================
{% endcomment %}

{%- case block.type -%}

  {%- comment -%} ============ VALORACIÓN (ESTRELLAS) ============ {%- endcomment -%}
  {%- when 'zzen_rating' -%}

    {%- liquid
      assign b = block.settings
      assign rating_num = b.rating_value | plus: 0.0
      if rating_num > 5
        assign rating_num = 5
      endif
      if rating_num < 0
        assign rating_num = 0
      endif
      assign fill_pct = rating_num | divided_by: 5.0 | times: 100
      assign star_count = b.star_count
    -%}

    {%- style -%}
      .zzen-rating-{{ block.id }} {
        display: flex;
        align-items: center;
        gap: {{ b.gap_stars_text }}px;
        margin: 0 0 {{ b.margin_bottom_mobile }}px;
        justify-content: {{ b.align_mobile }};
        flex-wrap: wrap;
      }

      .zzen-rating-{{ block.id }}__link {
        display: flex;
        align-items: center;
        gap: {{ b.gap_stars_text }}px;
        text-decoration: none;
        color: inherit;
        flex-wrap: wrap;
        justify-content: {{ b.align_mobile }};
      }

      .zzen-rating-{{ block.id }}__link:hover .zzen-rating-{{ block.id }}__text {
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .zzen-rating-{{ block.id }}__stars {
        position: relative;
        display: inline-flex;
        line-height: 0;
        flex: 0 0 auto;
      }

      .zzen-rating-{{ block.id }}__layer {
        display: inline-flex;
        gap: {{ b.gap_stars }}px;
        line-height: 0;
      }

      .zzen-rating-{{ block.id }}__layer svg {
        width: {{ b.star_size_mobile }}px;
        height: {{ b.star_size_mobile }}px;
        display: block;
        flex: 0 0 auto;
      }

      .zzen-rating-{{ block.id }}__layer--empty svg { fill: {{ b.star_color_empty }}; }
      .zzen-rating-{{ block.id }}__layer--full svg { fill: {{ b.star_color }}; }

      .zzen-rating-{{ block.id }}__layer--full {
        position: absolute;
        top: 0;
        {% if b.align_mobile == 'flex-end' %}right: 0;{% else %}left: 0;{% endif %}
        overflow: hidden;
        white-space: nowrap;
        width: {{ fill_pct }}%;
      }

      .zzen-rating-{{ block.id }}__text {
        margin: 0;
        font-family: {% if b.use_theme_font %}var(--font-body-family){% else %}{{ b.custom_font_stack }}{% endif %};
        font-style: normal;
        color: {{ b.text_color }};
        font-size: {{ b.text_size_mobile }}px;
        font-weight: {{ b.text_weight }};
        letter-spacing: {{ b.letter_spacing }}px;
        line-height: 1.3;
      }

      {% if b.show_mobile == false %}
        .zzen-rating-{{ block.id }} { display: none; }
      {% endif %}

      @media screen and (min-width: 750px) {
        .zzen-rating-{{ block.id }} {
          justify-content: {{ b.align_desktop }};
          margin-bottom: {{ b.margin_bottom_desktop }}px;
          {% if b.show_mobile == false and b.show_desktop %}display: flex;{% endif %}
          {% if b.show_desktop == false %}display: none;{% endif %}
        }
        .zzen-rating-{{ block.id }}__link {
          justify-content: {{ b.align_desktop }};
        }
        .zzen-rating-{{ block.id }}__layer svg {
          width: {{ b.star_size_desktop }}px;
          height: {{ b.star_size_desktop }}px;
        }
        .zzen-rating-{{ block.id }}__layer--full {
          {% if b.align_desktop == 'flex-end' %}right: 0; left: auto;{% else %}left: 0; right: auto;{% endif %}
        }
        .zzen-rating-{{ block.id }}__text {
          font-size: {{ b.text_size_desktop }}px;
        }
      }
    {%- endstyle -%}

    {%- capture stars_markup -%}
      <span
        class="zzen-rating-{{ block.id }}__stars"
        role="img"
        aria-label="{{ rating_num }} / 5"
      >
        <span class="zzen-rating-{{ block.id }}__layer zzen-rating-{{ block.id }}__layer--empty" aria-hidden="true">
          {%- for i in (1..star_count) -%}
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M12 1.6l3.09 6.7 7.31.86-5.35 5.06 1.4 7.18L12 17.9l-6.45 3.5 1.4-7.18L1.6 9.16l7.31-.86L12 1.6z"/></svg>
          {%- endfor -%}
        </span>
        <span class="zzen-rating-{{ block.id }}__layer zzen-rating-{{ block.id }}__layer--full" aria-hidden="true">
          {%- for i in (1..star_count) -%}
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M12 1.6l3.09 6.7 7.31.86-5.35 5.06 1.4 7.18L12 17.9l-6.45 3.5 1.4-7.18L1.6 9.16l7.31-.86L12 1.6z"/></svg>
          {%- endfor -%}
        </span>
      </span>
    {%- endcapture -%}

    {%- capture text_markup -%}
      {%- if b.text != blank -%}
        <span class="zzen-rating-{{ block.id }}__text">{{ b.text }}</span>
      {%- endif -%}
    {%- endcapture -%}

    <div class="zzen-rating zzen-rating-{{ block.id }}" {{ block.shopify_attributes }}>
      {%- if b.link != blank -%}
        <a href="{{ b.link }}" class="zzen-rating-{{ block.id }}__link">
          {{ stars_markup }}
          {{ text_markup }}
        </a>
      {%- else -%}
        {{ stars_markup }}
        {{ text_markup }}
      {%- endif -%}
    </div>

  {%- comment -%} ============ ETIQUETA / BADGE ============ {%- endcomment -%}
  {%- when 'zzen_badge' -%}

    {%- liquid
      assign b = block.settings
      assign inline_class = ''
      if b.mobile_layout == 'inline'
        assign inline_class = ' zzen-badge--inline-mobile'
      endif
    -%}

    {%- style -%}
      .zzen-badge-{{ block.id }} {
        display: flex;
        justify-content: {{ b.align_mobile }};
        margin: 0 0 {{ b.margin_bottom_mobile }}px;
      }

      .zzen-badge-{{ block.id }}__pill {
        display: inline-flex;
        align-items: center;
        gap: {{ b.gap_icon_text }}px;
        background-color: {{ b.bg_color }};
        border: {{ b.border_width }}px solid {{ b.border_color }};
        border-radius: {{ b.border_radius }}px;
        padding: {{ b.padding_y_mobile }}px {{ b.padding_x_mobile }}px;
        text-decoration: none;
        white-space: nowrap;
        box-sizing: border-box;
      }

      .zzen-badge-{{ block.id }}__icon {
        display: block;
        flex: 0 0 auto;
        width: {{ b.icon_size_mobile }}px;
        height: {{ b.icon_size_mobile }}px;
        color: {{ b.icon_color }};
      }

      .zzen-badge-{{ block.id }}__icon svg,
      .zzen-badge-{{ block.id }}__icon img {
        width: 100%;
        height: 100%;
        display: block;
      }

      .zzen-badge-{{ block.id }}__icon img {
        object-fit: contain;
      }

      .zzen-badge-{{ block.id }}__text {
        font-family: {% if b.use_theme_font %}var(--font-body-family){% else %}{{ b.custom_font_stack }}{% endif %};
        font-style: normal;
        color: {{ b.text_color }};
        font-size: {{ b.text_size_mobile }}px;
        font-weight: {{ b.text_weight }};
        letter-spacing: {{ b.letter_spacing }}px;
        line-height: 1.2;
        {% if b.uppercase %}text-transform: uppercase;{% endif %}
      }

      {% if b.show_mobile == false %}
        .zzen-badge-{{ block.id }} { display: none; }
      {% endif %}

      @media screen and (min-width: 750px) {
        .zzen-badge-{{ block.id }} {
          justify-content: {{ b.align_desktop }};
          margin-bottom: {{ b.margin_bottom_desktop }}px;
          {% if b.show_mobile == false and b.show_desktop %}display: flex;{% endif %}
          {% if b.show_desktop == false %}display: none;{% endif %}
        }
        .zzen-badge-{{ block.id }}__pill {
          padding: {{ b.padding_y_desktop }}px {{ b.padding_x_desktop }}px;
        }
        .zzen-badge-{{ block.id }}__icon {
          width: {{ b.icon_size_desktop }}px;
          height: {{ b.icon_size_desktop }}px;
        }
        .zzen-badge-{{ block.id }}__text {
          font-size: {{ b.text_size_desktop }}px;
        }
      }
    {%- endstyle -%}

    {%- capture badge_icon -%}
      {%- if b.icon_image != blank -%}
        <span class="zzen-badge-{{ block.id }}__icon">
          {{ b.icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
        </span>
      {%- elsif b.icon_style != 'none' -%}
        <span class="zzen-badge-{{ block.id }}__icon" aria-hidden="true">
          {%- if b.icon_style == 'check_circle' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <circle cx="12" cy="12" r="9.2"/>
              <path d="M8 12.3l2.7 2.7L16 9.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {%- elsif b.icon_style == 'check' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M4.5 12.5l5 5L19.5 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {%- elsif b.icon_style == 'star' -%}
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M12 1.6l3.09 6.7 7.31.86-5.35 5.06 1.4 7.18L12 17.9l-6.45 3.5 1.4-7.18L1.6 9.16l7.31-.86L12 1.6z"/>
            </svg>
          {%- elsif b.icon_style == 'fire' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" xmlns="http://www.w3.org/2000/svg" focusable="false">
              <path d="M12 2.5c2.6 3.2 1.2 5.1.3 6.2-.6.8-.3 2 .8 2.2 1.4.3 2.2-1 2.3-2.3 1.8 1.7 2.8 3.7 2.8 5.9a6.2 6.2 0 1 1-12.4 0c0-4.6 3.6-6.7 4.9-9.4.5-1 .8-1.9 1.3-2.6z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {%- endif -%}
        </span>
      {%- endif -%}
    {%- endcapture -%}

    <div class="zzen-badge zzen-badge-{{ block.id }}{{ inline_class }}" {{ block.shopify_attributes }}>
      {%- if b.link != blank -%}
        <a href="{{ b.link }}" class="zzen-badge-{{ block.id }}__pill">
          {{ badge_icon }}
          <span class="zzen-badge-{{ block.id }}__text">{{ b.text }}</span>
        </a>
      {%- else -%}
        <span class="zzen-badge-{{ block.id }}__pill">
          {{ badge_icon }}
          <span class="zzen-badge-{{ block.id }}__text">{{ b.text }}</span>
        </span>
      {%- endif -%}
    </div>

{%- endcase -%}
