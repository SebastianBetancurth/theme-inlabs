{% comment %}
  ============================================================
  SECCIÓN: Ingredientes con Tabs + Carrusel + Modal
  Theme: Dawn (compatible con cualquier theme OS 2.0)
  Archivo: sections/ingredients-tabs.liquid
  ------------------------------------------------------------
  - Tabs generadas automáticamente según el campo "Tab" de
    cada bloque de ingrediente.
  - Carrusel horizontal con flechas (desktop) y scroll táctil
    (mobile) + scrollbar fina.
  - Modal implementado con <dialog> nativo + showModal():
    se renderiza en el TOP LAYER del navegador, por encima de
    todo, inmune a z-index, transforms y overflow del theme.
    El overlay oscuro es el ::backdrop nativo del dialog.
  - Se cierra con click fuera, flecha <- o tecla Esc (nativo).
  ============================================================
{% endcomment %}

{%- liquid
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign overlay_color = section.settings.color_overlay | color_modify: 'alpha', overlay_alpha
  assign sid = section.id
  assign ratio = '1 / 1'
  if section.settings.image_ratio == 'portrait'
    assign ratio = '4 / 5'
  elsif section.settings.image_ratio == 'landscape'
    assign ratio = '4 / 3'
  endif

  comment
    Construir lista de tabs únicas en orden de aparición
  endcomment
  assign tabs_raw = '||'
  for block in section.blocks
    assign tname = block.settings.tab | strip
    if tname == blank
      assign tname = 'General'
    endif
    assign token = '||' | append: tname | append: '||'
    unless tabs_raw contains token
      assign tabs_raw = tabs_raw | append: tname | append: '||'
    endunless
  endfor
  assign tab_list = tabs_raw | split: '||'
-%}

{%- style -%}
  #shopify-section-{{ sid }} .zi-section {
    --zi-bg: {{ section.settings.color_bg }};
    --zi-heading-color: {{ section.settings.color_heading }};
    --zi-heading-size: {{ section.settings.heading_size }}px;
    --zi-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --zi-tab-bg: {{ section.settings.color_tab_bg }};
    --zi-tab-text: {{ section.settings.color_tab_text }};
    --zi-tab-border: {{ section.settings.color_tab_border }};
    --zi-tab-active-bg: {{ section.settings.color_tab_active_bg }};
    --zi-tab-active-text: {{ section.settings.color_tab_active_text }};
    --zi-carousel-bg: {{ section.settings.color_carousel_bg }};
    --zi-card-bg: {{ section.settings.color_card_bg }};
    --zi-card-title: {{ section.settings.color_card_title }};
    --zi-card-dose: {{ section.settings.color_card_dose }};
    --zi-link: {{ section.settings.color_link }};
    --zi-arrow: {{ section.settings.color_arrow }};
    --zi-card-width: {{ section.settings.card_width }}px;
    --zi-card-width-mobile: {{ section.settings.card_width_mobile }}px;
    --zi-card-gap: {{ section.settings.card_gap }}px;
    --zi-card-radius: {{ section.settings.card_radius }}px;
    --zi-container-radius: {{ section.settings.container_radius }}px;
    --zi-image-ratio: {{ ratio }};
    --zi-max-width: {{ section.settings.max_width }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--zi-bg);
  }

  /* ============ LAYOUT GENERAL ============ */
  #shopify-section-{{ sid }} .zi-wrapper {
    max-width: var(--zi-max-width);
    margin: 0 auto;
    padding: 0 5rem;
    position: relative;
  }
  {% if section.settings.full_width %}
    #shopify-section-{{ sid }} .zi-wrapper { max-width: 100%; }
  {% endif %}

  #shopify-section-{{ sid }} .zi-heading {
    font-family: "thin2", sans-serif;
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    color: var(--zi-heading-color);
    font-size: var(--zi-heading-size);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 2.4rem;
  }

  /* ============ TABS ============ */
  #shopify-section-{{ sid }} .zi-tabs {
    display: flex;
    gap: 1.2rem;
    flex-wrap: nowrap;
    overflow-x: auto;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
  }
  /* Scrollbar fina y redondeada, igual a la del carrusel.
     Solo aparece cuando hay más tabs de las que entran en el ancho. */
  #shopify-section-{{ sid }} .zi-tabs::-webkit-scrollbar {
    height: 5px;
  }
  #shopify-section-{{ sid }} .zi-tabs::-webkit-scrollbar-button {
    display: none;
    width: 0;
    height: 0;
  }
  #shopify-section-{{ sid }} .zi-tabs::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, .07);
    border-radius: 100px;
  }
  #shopify-section-{{ sid }} .zi-tabs::-webkit-scrollbar-thumb {
    background: #9c9c9c;
    border-radius: 100px;
  }
  #shopify-section-{{ sid }} .zi-tabs::-webkit-scrollbar-thumb:hover {
    background: #7d7d7d;
  }
  /* Fallback SOLO para Firefox */
  @supports not selector(::-webkit-scrollbar) {
    #shopify-section-{{ sid }} .zi-tabs {
      scrollbar-width: thin;
      scrollbar-color: #9c9c9c rgba(0, 0, 0, .07);
    }
  }

  #shopify-section-{{ sid }} .zi-tab {
    flex: 0 0 auto;
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    line-height: 1;
    padding: 1.3rem 2.6rem;
    background: var(--zi-tab-bg);
    color: var(--zi-tab-text);
    border: 1px solid var(--zi-tab-border);
    border-radius: 6px;
    cursor: pointer;
    transition: background .2s ease, color .2s ease;
    white-space: nowrap;
  }
  #shopify-section-{{ sid }} .zi-tab:hover {
    background: var(--zi-tab-active-bg);
    color: var(--zi-tab-active-text);
    border-color: var(--zi-tab-active-bg);
  }
  #shopify-section-{{ sid }} .zi-tab[aria-selected='true'] {
    background: var(--zi-tab-active-bg);
    color: var(--zi-tab-active-text);
    border-color: var(--zi-tab-active-bg);
  }

  /* ============ CARRUSEL ============ */
  #shopify-section-{{ sid }} .zi-carousel {
    position: relative;
  }
  #shopify-section-{{ sid }} .zi-panel {
    background: var(--zi-carousel-bg);
    border-radius: var(--zi-container-radius);
    padding: 3rem 0 1.6rem;
  }
  #shopify-section-{{ sid }} .zi-slider {
    display: flex;
    gap: var(--zi-card-gap);
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 0 3rem 1.8rem;
    {% unless section.settings.show_scrollbar %}
      scrollbar-width: none;
      -ms-overflow-style: none;
    {% endunless %}
  }
  {% if section.settings.show_scrollbar %}
    /* Scrollbar fina y redondeada (Chrome / Edge / Safari).
       IMPORTANTE: no usar scrollbar-width / scrollbar-color acá,
       porque Chrome 121+ ignora ::-webkit-scrollbar si están
       presentes y muestra su barra básica con flechas. */
    #shopify-section-{{ sid }} .zi-slider::-webkit-scrollbar {
      height: 5px;
    }
    #shopify-section-{{ sid }} .zi-slider::-webkit-scrollbar-button {
      display: none;
      width: 0;
      height: 0;
    }
    #shopify-section-{{ sid }} .zi-slider::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, .07);
      border-radius: 100px;
      margin: 0 3rem;
    }
    #shopify-section-{{ sid }} .zi-slider::-webkit-scrollbar-thumb {
      background: #9c9c9c;
      border-radius: 100px;
    }
    #shopify-section-{{ sid }} .zi-slider::-webkit-scrollbar-thumb:hover {
      background: #7d7d7d;
    }
    /* Fallback SOLO para Firefox (no soporta ::-webkit-scrollbar) */
    @supports not selector(::-webkit-scrollbar) {
      #shopify-section-{{ sid }} .zi-slider {
        scrollbar-width: thin;
        scrollbar-color: #9c9c9c rgba(0, 0, 0, .07);
      }
    }
  {% else %}
    #shopify-section-{{ sid }} .zi-slider::-webkit-scrollbar { display: none; }
  {% endif %}

  /* ============ CARDS ============ */
  #shopify-section-{{ sid }} .zi-card {
    flex: 0 0 var(--zi-card-width);
    width: var(--zi-card-width);
    background: var(--zi-card-bg);
    border: 1px solid rgba(0,0,0,.06);
    border-radius: var(--zi-card-radius);
    padding: 1.2rem 1.2rem 1.4rem;
    cursor: pointer;
    text-align: left;
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 3px rgba(0,0,0,.04);
    transition: transform .25s ease, box-shadow .25s ease;
    -webkit-appearance: none;
    appearance: none;
    font-family: var(--font-body-family);
  }
  #shopify-section-{{ sid }} .zi-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,.08);
  }
  #shopify-section-{{ sid }} .zi-card__media {
    width: 100%;
    aspect-ratio: var(--zi-image-ratio);
    border-radius: calc(var(--zi-card-radius) - 4px);
    overflow: hidden;
    background: #eee;
    margin-bottom: 1.6rem;
  }
  #shopify-section-{{ sid }} .zi-card__media img,
  #shopify-section-{{ sid }} .zi-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ sid }} .zi-card__title {
    font-size: 2rem;
    color: var(--zi-card-title);
    margin: 0 0 .4rem;
    font-weight: 400;
    line-height: 1.2;
  }
  #shopify-section-{{ sid }} .zi-card__dose {
    font-size: 1.5rem;
    color: var(--zi-card-dose);
    margin: 0 0 1.6rem;
  }
  #shopify-section-{{ sid }} .zi-card__more {
    margin-top: auto;
    align-self: flex-end;
    font-size: 1.2rem;
    color: var(--zi-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ============ FLECHAS ============ */
  #shopify-section-{{ sid }} .zi-arrow-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 1rem;
    color: var(--zi-arrow);
    z-index: 2;
    line-height: 0;
  }
  #shopify-section-{{ sid }} .zi-arrow-btn svg { width: 2rem; height: 3.4rem; }
  #shopify-section-{{ sid }} .zi-arrow-btn--prev { left: 1rem; }
  #shopify-section-{{ sid }} .zi-arrow-btn--next { right: 1rem; }
  #shopify-section-{{ sid }} .zi-arrow-btn:hover { opacity: .6; }

  /* ============ MODAL (dialog nativo, top layer) ============ */
  #ZiModal-{{ sid }} {
    border: 0;
    padding: 0;
    margin: auto; /* centra el dialog en el viewport */
    background: {{ section.settings.color_modal_bg }};
    color: {{ section.settings.color_modal_text }};
    width: calc(100% - 3rem);
    max-width: 60rem;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 14px;
    font-family: var(--font-body-family);
  }
  #ZiModal-{{ sid }}[open] {
    animation: zi-pop .28s cubic-bezier(.2,.9,.3,1.1);
  }
  /* Overlay oscuro nativo del dialog: nada del theme puede taparlo */
  #ZiModal-{{ sid }}::backdrop {
    background: {{ overlay_color }};
    animation: zi-fade .25s ease;
  }
  @keyframes zi-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes zi-pop { from { opacity: 0; transform: translateY(14px) scale(.98); } to { opacity: 1; transform: none; } }

  #ZiModal-{{ sid }} .zi-modal__media {
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-radius: 14px 14px 0 0;
    background: #eee;
  }
  #ZiModal-{{ sid }} .zi-modal__media img,
  #ZiModal-{{ sid }} .zi-modal__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #ZiModal-{{ sid }} .zi-modal__body { padding: 2.4rem 3rem 3rem; }
  #ZiModal-{{ sid }} .zi-modal__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.8rem;
  }
  #ZiModal-{{ sid }} .zi-modal__title {
    font-size: 2.6rem;
    margin: 0 0 .3rem;
    font-weight: 400;
    line-height: 1.15;
  }
  #ZiModal-{{ sid }} .zi-modal__dose {
    font-size: 1.5rem;
    color: {{ section.settings.color_modal_secondary }};
    margin: 0;
  }
  #ZiModal-{{ sid }} .zi-modal__close {
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: .6rem;
    color: {{ section.settings.color_modal_text }};
    line-height: 0;
    flex: 0 0 auto;
  }
  #ZiModal-{{ sid }} .zi-modal__close svg { width: 3.2rem; height: 2.2rem; }
  #ZiModal-{{ sid }} .zi-modal__close:hover { opacity: .6; }
  #ZiModal-{{ sid }} .zi-modal__desc {
    font-size: 1.5rem;
    line-height: 1.55;
    margin-bottom: 2rem;
  }
  #ZiModal-{{ sid }} .zi-modal__desc p { margin: 0 0 1rem; }
  #ZiModal-{{ sid }} .zi-benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem 2.4rem;
  }
  #ZiModal-{{ sid }} .zi-benefits li {
    display: flex;
    gap: 1rem;
    font-size: 1.5rem;
    line-height: 1.4;
  }
  #ZiModal-{{ sid }} .zi-benefits svg {
    flex: 0 0 auto;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: .3rem;
  }

  /* ============ MOBILE ============ */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ sid }} .zi-wrapper { padding: 0 1.5rem; }
    #shopify-section-{{ sid }} .zi-heading { font-size: var(--zi-heading-size-mobile); margin-bottom: 1.8rem; }
    #shopify-section-{{ sid }} .zi-card { flex-basis: var(--zi-card-width-mobile); width: var(--zi-card-width-mobile); }
    #shopify-section-{{ sid }} .zi-panel { padding: 1.8rem 0 1rem; }
    #shopify-section-{{ sid }} .zi-slider { padding: 0 1.6rem 1.6rem; }
    #shopify-section-{{ sid }} .zi-slider::-webkit-scrollbar-track { margin: 0 1.6rem; }
    #shopify-section-{{ sid }} .zi-arrow-btn { display: none; }
    #ZiModal-{{ sid }} { width: calc(100% - 2rem); }
    #ZiModal-{{ sid }} .zi-modal__body { padding: 2rem 2rem 2.4rem; }
    #ZiModal-{{ sid }} .zi-benefits { grid-template-columns: 1fr; }
    #ZiModal-{{ sid }} .zi-modal__title { font-size: 2.2rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZiModal-{{ sid }}[open],
    #ZiModal-{{ sid }}::backdrop { animation: none; }
    #shopify-section-{{ sid }} .zi-slider { scroll-behavior: auto; }
    #shopify-section-{{ sid }} .zi-card { transition: none; }
  }
{%- endstyle -%}

<zi-ingredients-tabs class="zi-section" data-section-id="{{ sid }}">
  <div class="zi-wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="zi-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- comment -%} ---------- TABS ---------- {%- endcomment -%}
    <div class="zi-tabs" role="tablist" aria-label="{{ section.settings.heading | strip_html | escape }}">
      {%- assign first_tab = true -%}
      {%- for tab in tab_list -%}
        {%- if tab == blank -%}{%- continue -%}{%- endif -%}
        <button
          type="button"
          class="zi-tab"
          role="tab"
          data-tab-index="{{ forloop.index0 }}"
          data-tab-name="{{ tab | escape }}"
          aria-selected="{% if first_tab %}true{% else %}false{% endif %}"
        >
          {{ tab }}
        </button>
        {%- assign first_tab = false -%}
      {%- endfor -%}
    </div>

    {%- comment -%} ---------- PANELES (uno por tab) ---------- {%- endcomment -%}
    <div class="zi-carousel">
      {%- if section.settings.show_arrows -%}
        <button type="button" class="zi-arrow-btn zi-arrow-btn--prev" data-dir="-1" aria-label="{{ 'general.slider.previous_slide' | t | default: 'Anterior' }}">
          <svg viewBox="0 0 12 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M11 1L1 11L11 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="zi-arrow-btn zi-arrow-btn--next" data-dir="1" aria-label="{{ 'general.slider.next_slide' | t | default: 'Siguiente' }}">
          <svg viewBox="0 0 12 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M1 1L11 11L1 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- assign first_panel = true -%}
      {%- for tab in tab_list -%}
        {%- if tab == blank -%}{%- continue -%}{%- endif -%}
        <div class="zi-panel" role="tabpanel" data-panel-name="{{ tab | escape }}" {% unless first_panel %}hidden{% endunless %}>
          <div class="zi-slider">
            {%- for block in section.blocks -%}
              {%- assign btab = block.settings.tab | strip -%}
              {%- if btab == blank -%}{%- assign btab = 'General' -%}{%- endif -%}
              {%- if btab != tab -%}{%- continue -%}{%- endif -%}

              <button type="button" class="zi-card" data-card {{ block.shopify_attributes }}>
                <div class="zi-card__media">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(max-width: 749px) 70vw, 320px', alt: block.settings.title | escape }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
                <h3 class="zi-card__title">{{ block.settings.title | escape }}</h3>
                <p class="zi-card__dose">{{ block.settings.dosage | escape }}</p>
                <span class="zi-card__more">{{ section.settings.more_label | escape }}</span>

                {%- comment -%} Contenido del modal de esta card {%- endcomment -%}
                <template data-modal-content>
                  <div class="zi-modal__media">
                    {%- assign modal_img = block.settings.modal_image | default: block.settings.image -%}
                    {%- if modal_img != blank -%}
                      {{ modal_img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(max-width: 749px) 92vw, 600px', alt: block.settings.title | escape }}
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag }}
                    {%- endif -%}
                  </div>
                  <div class="zi-modal__body">
                    <div class="zi-modal__head">
                      <div>
                        <h3 class="zi-modal__title">{{ block.settings.title | escape }}</h3>
                        <p class="zi-modal__dose">{{ block.settings.dosage | escape }}</p>
                      </div>
                      <button type="button" class="zi-modal__close" aria-label="Cerrar">
                        <svg viewBox="0 0 32 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <path d="M11 1L1 11L11 21M1 11H31" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                    </div>
                    {%- if block.settings.description != blank -%}
                      <div class="zi-modal__desc">{{ block.settings.description }}</div>
                    {%- endif -%}
                    {%- if block.settings.benefits != blank -%}
                      {%- assign benefits_html = block.settings.benefits | strip | newline_to_br | replace: '<br/>', '<br />' -%}
                      {%- assign benefits = benefits_html | split: '<br />' -%}
                      <ul class="zi-benefits">
                        {%- for benefit in benefits -%}
                          {%- assign b = benefit | strip -%}
                          {%- if b == blank -%}{%- continue -%}{%- endif -%}
                          <li>
                            <svg viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                              <path d="M2 13L13 2M13 2H4M13 2V11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span>{{ b }}</span>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
                </template>
              </button>
            {%- endfor -%}
          </div>
        </div>
        {%- assign first_panel = false -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} ---------- MODAL: dialog nativo, se llena por JS ---------- {%- endcomment -%}
  <dialog class="zi-modal" id="ZiModal-{{ sid }}" aria-label="{{ 'Detalle del ingrediente' }}"></dialog>
</zi-ingredients-tabs>

<script>
  if (!customElements.get('zi-ingredients-tabs')) {
    customElements.define(
      'zi-ingredients-tabs',
      class ZiIngredientsTabs extends HTMLElement {
        connectedCallback() {
          this.tabs = Array.from(this.querySelectorAll('.zi-tab'));
          this.panels = Array.from(this.querySelectorAll('.zi-panel'));
          this.modal = this.querySelector('dialog.zi-modal');

          /* Tabs */
          this.tabs.forEach((tab) => {
            tab.addEventListener('click', () => this.selectTab(tab));
          });

          /* Flechas */
          this.querySelectorAll('.zi-arrow-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
              const slider = this.activeSlider();
              if (!slider) return;
              const dir = parseInt(btn.dataset.dir, 10);
              slider.scrollBy({ left: dir * slider.clientWidth * 0.75, behavior: 'smooth' });
            });
          });

          /* Abrir modal al hacer click en cualquier card */
          this.querySelectorAll('[data-card]').forEach((card) => {
            card.addEventListener('click', () => this.openModal(card));
          });

          /* Cerrar: click en el backdrop (target === dialog) o en el botón de cerrar.
             Esc lo maneja el dialog nativamente. */
          this.modal.addEventListener('click', (e) => {
            if (e.target === this.modal || e.target.closest('.zi-modal__close')) {
              this.modal.close();
            }
          });

          /* Al cerrarse (por cualquier vía) restaurar el scroll del body */
          this.modal.addEventListener('close', () => {
            this.modal.innerHTML = '';
            document.body.style.overflow = this.prevOverflow || '';
          });
        }

        activeSlider() {
          const panel = this.panels.find((p) => !p.hidden);
          return panel ? panel.querySelector('.zi-slider') : null;
        }

        selectTab(tab) {
          const name = tab.dataset.tabName;
          this.tabs.forEach((t) => t.setAttribute('aria-selected', t === tab ? 'true' : 'false'));
          this.panels.forEach((p) => {
            p.hidden = p.dataset.panelName !== name;
          });
        }

        openModal(card) {
          const tpl = card.querySelector('[data-modal-content]');
          if (!tpl) return;
          this.modal.innerHTML = '';
          this.modal.appendChild(tpl.content.cloneNode(true));
          this.prevOverflow = document.body.style.overflow;
          document.body.style.overflow = 'hidden';
          this.modal.showModal(); /* top layer: por encima de TODO */
        }

        disconnectedCallback() {
          if (this.modal && this.modal.open) this.modal.close();
          document.body.style.overflow = this.prevOverflow || '';
        }
      }
    );
  }
</script>

