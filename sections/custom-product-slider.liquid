{%- comment -%}
  ============================================================================
  SECCIÓN: Carrusel de producto (imagen + texto)
  Tema: Dawn / Online Store 2.0
  Ruta: sections/custom-product-slider.liquid

  PC     -> imagen + título grande + párrafos. Navegación: stepper con línea,
            puntos, etiquetas y flechas circulares.
  Móvil  -> imagen arriba, título y lista de beneficios con flecha ↗.
            Navegación: bullets centrados.

  Cada slide tiene contenido independiente para PC y para móvil.
  Todo configurable por separado en ambos breakpoints.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign bp = s.mobile_breakpoint
  assign bp_max = bp | minus: 1
  assign n = section.blocks.size

  case s.heading_font
    when 'thin2'
      assign heading_stack = "'thin2', 'Times New Roman', Georgia, serif"
    when 'helvetica'
      assign heading_stack = "'Helvetica neue', Helvetica, Arial, sans-serif"
    when 'theme_heading'
      assign heading_stack = 'var(--font-heading-family)'
    when 'theme_body'
      assign heading_stack = 'var(--font-body-family)'
    else
      assign heading_stack = s.heading_font_custom
  endcase

  case s.body_font
    when 'thin2'
      assign body_stack = "'thin2', 'Times New Roman', Georgia, serif"
    when 'helvetica'
      assign body_stack = "'Helvetica neue', Helvetica, Arial, sans-serif"
    when 'theme_heading'
      assign body_stack = 'var(--font-heading-family)'
    when 'theme_body'
      assign body_stack = 'var(--font-body-family)'
    else
      assign body_stack = s.body_font_custom
  endcase

  if s.content_max_width == 0
    assign max_w = 'none'
  else
    assign max_w = s.content_max_width | append: 'px'
  endif

-%}

{%- style -%}
  @font-face {
    font-family: 'Helvetica neue';
    src: url('{{ 'HelveticaNeueCyr-Light.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'thin2';
    src: url('{{ 'lawrence-regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* ================= Variables: PC ================= */
  .cslx-{{ section.id }} {
    --cslx-bg: {{ s.bg_color }};
    --cslx-max-w: {{ max_w }};
    --cslx-pt: {{ s.padding_top_d }}px;
    --cslx-pb: {{ s.padding_bottom_d }}px;
    --cslx-pl: {{ s.padding_left_d }}px;
    --cslx-pr: {{ s.padding_right_d }}px;
    --cslx-gap: {{ s.gap_d }}px;
    --cslx-align: {{ s.vertical_align_d }};
    --cslx-media-w: {{ s.media_width_d }}%;
    --cslx-focus: {{ s.image_focus }};
    --cslx-radius: {{ s.image_radius }}px;
    --cslx-dur: {{ s.fade_duration }}ms;
    --cslx-out: {{ s.fade_out_duration }}ms;
    --cslx-delay: {{ s.fade_out_duration }}ms;
    --cslx-ease: {{ s.fade_easing }};
    --cslx-shift: {{ s.fade_shift }}px;

    --cslx-h-font: {{ heading_stack }};
    --cslx-h-size: {{ s.heading_size_d }}px;
    --cslx-h-lh: {{ s.heading_line_height_d }};
    --cslx-h-ls: {{ s.heading_letter_spacing_d }}px;
    --cslx-h-weight: {{ s.heading_weight }};
    --cslx-h-color: {{ s.heading_color }};
    --cslx-h-align: {{ s.heading_align_d }};
    --cslx-h-mb: {{ s.heading_margin_bottom_d }}px;

    --cslx-b-font: {{ body_stack }};
    --cslx-b-size: {{ s.body_size_d }}px;
    --cslx-b-lh: {{ s.body_line_height_d }};
    --cslx-b-ls: {{ s.body_letter_spacing_d }}px;
    --cslx-b-weight: {{ s.body_weight }};
    --cslx-b-color: {{ s.body_color }};
    --cslx-b-align: {{ s.body_align_d }};
    --cslx-p-gap: {{ s.paragraph_gap_d }}px;

    --cslx-li-size: {{ s.bullet_size_m }}px;
    --cslx-li-lh: {{ s.bullet_line_height_m }};
    --cslx-li-color: {{ s.bullet_color }};
    --cslx-li-gap: {{ s.bullet_gap_m }}px;
    --cslx-li-icon: {{ s.bullet_icon_size }}px;
    --cslx-li-icon-color: {{ s.bullet_icon_color }};
    --cslx-li-icon-gap: {{ s.bullet_icon_gap }}px;

    --cslx-nav-mt: {{ s.nav_margin_top_d }}px;
    --cslx-nav-gap: {{ s.nav_gap }}px;
    --cslx-line: {{ s.line_color }};
    --cslx-dot: {{ s.dot_size_d }}px;
    --cslx-dot-border: {{ s.dot_border_color }};
    --cslx-dot-active: {{ s.dot_active_color }};
    --cslx-label-size: {{ s.label_size_d }}px;
    --cslx-label-color: {{ s.label_color }};
    --cslx-label-active: {{ s.label_active_color }};
    --cslx-label-gap: {{ s.label_gap }}px;
    --cslx-arrow-size: {{ s.arrow_size }}px;
    --cslx-arrow-border: {{ s.arrow_border_color }};
    --cslx-arrow-icon: {{ s.arrow_icon_color }};
    --cslx-arrow-gap: {{ s.arrow_gap }}px;
    --cslx-pag: {{ s.pagdot_size }}px;
    --cslx-pag-gap: {{ s.pagdot_gap }}px;
    --cslx-pag-active: {{ s.pagdot_active_color }};
    --cslx-pag-inactive: {{ s.pagdot_inactive_color }};
  }

  /* ================= Estructura ================= */
  .cslx {
    background-color: var(--cslx-bg)!important ;
  }

  .cslx__wrap {
    max-width: var(--cslx-max-w);
    margin-inline: auto;
    padding: var(--cslx-pt) var(--cslx-pr) var(--cslx-pb) var(--cslx-pl);
    box-sizing: border-box;
  }

  .cslx__stack {
    display: grid;
    grid-template-areas: 'stack';
    overflow: hidden;
  }

  /* Todas las slides ocupan la misma celda: la altura es la de la más alta,
     así el bloque no salta al cambiar de producto. */

  /* Estado inactivo. Es también el estado al que vuelve la slide que sale,
     por eso lleva la duración de salida y NO lleva retardo. */
  .cslx__slide {
    grid-area: stack;
    opacity: 0;
    transform: translateY(var(--cslx-shift));
    pointer-events: none;
    z-index: 0;
    transition: opacity var(--cslx-out) var(--cslx-ease),
      transform var(--cslx-out) var(--cslx-ease);
  }

  /* La slide que entra espera con un retardo igual a la duración de salida:
     así la anterior ya se ha desvanecido por completo y los dos textos
     nunca se ven superpuestos. */
  .cslx__slide.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    z-index: 2;
    transition: opacity var(--cslx-dur) var(--cslx-ease) var(--cslx-delay),
      transform var(--cslx-dur) var(--cslx-ease) var(--cslx-delay);
  }

  .cslx__slide-inner {
    display: flex;
    flex-direction: row;
    align-items: var(--cslx-align);
    gap: var(--cslx-gap);
  }

  .cslx--media-right .cslx__slide-inner {
    flex-direction: row-reverse;
  }

  .cslx__media {
    flex: 0 0 var(--cslx-media-w);
    min-width: 0;
  }

  .cslx__content {
    flex: 1 1 auto;
    min-width: 0;
  }

  /* La proporción se aplica al MARCO (un div normal), no al <img>.
     En un elemento reemplazado dentro de <picture> con atributos width/height,
     la proporción natural del archivo puede ganar y la imagen sale alargada. */
  .cslx__frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--cslx-radius);
  }

  .cslx__frame > picture {
    display: block;
  }

  .cslx__img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: var(--cslx-focus);
  }

  .cslx__placeholder {
    display: block;
    background: rgba(127, 127, 127, 0.1);
    aspect-ratio: 1 / 1;
  }

  .cslx__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0.35;
  }

  /* ================= Título y texto ================= */
  .cslx__heading {
    margin: 0 0 var(--cslx-h-mb);
    font-family: var(--cslx-h-font);
    font-size: var(--cslx-h-size);
    font-weight: var(--cslx-h-weight);
    line-height: var(--cslx-h-lh);
    letter-spacing: var(--cslx-h-ls);
    text-align: var(--cslx-h-align);
    color: var(--cslx-h-color);
  }

  .cslx__heading em,
  .cslx__heading i {
    font-style: italic;
  }

  .cslx__body {
    font-family: var(--cslx-b-font);
    font-size: var(--cslx-b-size);
    font-weight: var(--cslx-b-weight);
    line-height: var(--cslx-b-lh);
    letter-spacing: var(--cslx-b-ls);
    text-align: var(--cslx-b-align);
    color: var(--cslx-b-color);
  }

  .cslx__body > * {
    margin: 0;
  }

  .cslx__body > * + * {
    margin-top: var(--cslx-p-gap);
  }

  .cslx__body p:empty {
    display: none;
  }

  .cslx__body a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cslx__body strong {
    font-weight: 600;
  }

  /* ================= Lista de beneficios (móvil) ================= */
  .cslx__list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--cslx-b-font);
    font-size: var(--cslx-li-size);
    line-height: var(--cslx-li-lh);
    color: var(--cslx-li-color);
  }

  .cslx__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--cslx-li-icon-gap);
  }

  .cslx__list li + li {
    margin-top: var(--cslx-li-gap);
  }

  .cslx__list-icon {
    flex: 0 0 auto;
    width: var(--cslx-li-icon);
    height: var(--cslx-li-icon);
    margin-top: calc((var(--cslx-li-size) * var(--cslx-li-lh) - var(--cslx-li-icon)) / 2);
    color: var(--cslx-li-icon-color);
  }

  .cslx__list-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cslx__list strong {
    font-weight: 600;
  }

  /* ================= Navegación ================= */
  .cslx__nav {
    display: flex;
    align-items: flex-start;
    gap: var(--cslx-nav-gap);
    margin-top: var(--cslx-nav-mt);
  }

  .cslx__steps,
  .cslx__dots,
  .cslx__arrows {
    display: none;
  }

  .cslx__steps {
    position: relative;
    flex: 1 1 auto;
    grid-template-columns: repeat(var(--cslx-n), minmax(0, 1fr));
  }

  .cslx__steps-line {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--cslx-dot) / 2);
    height: 1px;
    background: var(--cslx-line);
  }

  .cslx__step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--cslx-label-gap);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  .cslx__step-dot {
    width: var(--cslx-dot);
    height: var(--cslx-dot);
    border-radius: 50%;
    border: 1.5px solid var(--cslx-dot-border);
    background: var(--cslx-bg);
    box-sizing: border-box;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .cslx__step[aria-current='true'] .cslx__step-dot {
    background: var(--cslx-dot-active);
    border-color: var(--cslx-dot-active);
  }

  .cslx__step-label {
    font-family: var(--cslx-b-font);
    font-size: var(--cslx-label-size);
    line-height: 1.2;
    color: var(--cslx-label-color);
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .cslx__step[aria-current='true'] .cslx__step-label {
    color: var(--cslx-label-active);
    font-weight: 500;
  }

  .cslx__step:focus-visible {
    outline: 2px solid var(--cslx-dot-active);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .cslx__arrows {
    flex: 0 0 auto;
    gap: var(--cslx-arrow-gap);
  }

  .cslx__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--cslx-arrow-size);
    height: var(--cslx-arrow-size);
    padding: 0;
    border: 1px solid var(--cslx-arrow-border);
    border-radius: 50%;
    background: transparent;
    color: var(--cslx-arrow-icon);
    cursor: pointer;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }

  .cslx__arrow:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .cslx__arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  .cslx__arrow:focus-visible {
    outline: 2px solid var(--cslx-dot-active);
    outline-offset: 2px;
  }

  .cslx__arrow svg {
    display: block;
    width: 40%;
    height: 40%;
  }

  .cslx__dots {
    flex: 1 1 auto;
    justify-content: center;
    align-items: center;
    gap: var(--cslx-pag-gap);
  }

  .cslx__pag {
    width: var(--cslx-pag);
    height: var(--cslx-pag);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--cslx-pag-inactive);
    cursor: pointer;
    transition: background-color 0.25s ease;
  }

  .cslx__pag[aria-current='true'] {
    background: var(--cslx-pag-active);
  }

  .cslx__pag:focus-visible {
    outline: 2px solid var(--cslx-pag-active);
    outline-offset: 3px;
  }

  /* ================= Visibilidad por breakpoint ================= */
  .cslx__only-mobile {
    display: none;
  }

  @media screen and (min-width: {{ bp }}px) {
    .cslx--nav-d-stepper .cslx__steps { display: grid; }
    .cslx--nav-d-dots .cslx__dots { display: flex; }
    .cslx--arrows-d .cslx__arrows { display: flex; }

    {%- if s.aspect_d != 'natural' -%}
      .cslx-{{ section.id }} .cslx__frame {
        aspect-ratio: {{ s.aspect_d }};
      }
      .cslx-{{ section.id }} .cslx__frame > picture,
      .cslx-{{ section.id }} .cslx__placeholder {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      .cslx-{{ section.id }} .cslx__img {
        height: 100%;
      }
    {%- endif -%}
  }

  /* ================= Móvil ================= */
  @media screen and (max-width: {{ bp_max }}px) {
    .cslx-{{ section.id }} {
      --cslx-max-w: none;
      --cslx-pt: {{ s.padding_top_m }}px;
      --cslx-pb: {{ s.padding_bottom_m }}px;
      --cslx-pl: {{ s.padding_left_m }}px;
      --cslx-pr: {{ s.padding_right_m }}px;
      --cslx-gap: {{ s.gap_m }}px;

      --cslx-h-size: {{ s.heading_size_m }}px;
      --cslx-h-lh: {{ s.heading_line_height_m }};
      --cslx-h-ls: {{ s.heading_letter_spacing_m }}px;
      --cslx-h-align: {{ s.heading_align_m }};
      --cslx-h-mb: {{ s.heading_margin_bottom_m }}px;

      --cslx-b-size: {{ s.body_size_m }}px;
      --cslx-b-lh: {{ s.body_line_height_m }};
      --cslx-b-ls: {{ s.body_letter_spacing_m }}px;
      --cslx-b-align: {{ s.body_align_m }};
      --cslx-p-gap: {{ s.paragraph_gap_m }}px;

      --cslx-nav-mt: {{ s.nav_margin_top_m }}px;
    }

    .cslx__slide-inner,
    .cslx--media-right .cslx__slide-inner {
      flex-direction: column;
    }

    .cslx__media,
    .cslx__content {
      flex: 0 0 auto;
      width: 100%;
    }

    .cslx__only-desktop {
      display: none;
    }

    .cslx__only-mobile {
      display: block;
    }

    .cslx--nav-m-stepper .cslx__steps { display: grid; }
    .cslx--nav-m-dots .cslx__dots { display: flex; }
    .cslx--arrows-m .cslx__arrows { display: flex; }

    {%- if s.aspect_m != 'natural' -%}
      .cslx-{{ section.id }} .cslx__frame {
        aspect-ratio: {{ s.aspect_m }};
      }
      .cslx-{{ section.id }} .cslx__frame > picture,
      .cslx-{{ section.id }} .cslx__placeholder {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      .cslx-{{ section.id }} .cslx__img {
        height: 100%;
      }
    {%- endif -%}
  }

  @media (prefers-reduced-motion: reduce) {
    .cslx__slide {
      transition: none !important;
    }
    .cslx * {
      transition: none !important;
    }
  }
{%- endstyle -%}

<cslx-slider
  class="cslx cslx-{{ section.id }} cslx--media-{{ s.image_position_d }} cslx--nav-d-{{ s.nav_style_d }} cslx--nav-m-{{ s.nav_style_m }}{% if s.show_arrows_d %} cslx--arrows-d{% endif %}{% if s.show_arrows_m %} cslx--arrows-m{% endif %}"
  {% if s.loop %}data-loop="true"{% endif %}
  role="region"
  aria-roledescription="carrusel"
  aria-label="{{ s.aria_label | escape }}"
>
  <div class="cslx__wrap">
    <div class="cslx__stack" data-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign img_d = block.settings.image
          assign img_m = block.settings.image_mobile
          assign has_m = false
          if img_m != blank
            assign has_m = true
          endif
          if img_d == blank and has_m
            assign img_d = img_m
            assign has_m = false
          endif
        -%}
        <div
          class="cslx__slide{% if forloop.first %} is-active{% endif %}"
          data-slide
          data-index="{{ forloop.index0 }}"
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
          {{ block.shopify_attributes }}
        >
          <div class="cslx__slide-inner">
            <div class="cslx__media">
              <div class="cslx__frame">
              {%- if img_d != blank -%}
                <picture>
                  {%- if has_m -%}
                    <source
                      media="(max-width: {{ bp_max }}px)"
                      srcset="
                        {{ img_m | image_url: width: 400 }} 400w,
                        {{ img_m | image_url: width: 600 }} 600w,
                        {{ img_m | image_url: width: 900 }} 900w,
                        {{ img_m | image_url: width: 1200 }} 1200w
                      "
                      sizes="100vw"
                      width="{{ img_m.width }}"
                      height="{{ img_m.height }}"
                    >
                  {%- endif -%}
                  <img
                    class="cslx__img"
                    src="{{ img_d | image_url: width: 1200 }}"
                    srcset="
                      {{ img_d | image_url: width: 400 }} 400w,
                      {{ img_d | image_url: width: 600 }} 600w,
                      {{ img_d | image_url: width: 800 }} 800w,
                      {{ img_d | image_url: width: 1200 }} 1200w,
                      {{ img_d | image_url: width: 1600 }} 1600w
                    "
                    sizes="(min-width: {{ bp }}px) {{ s.media_width_d }}vw, 100vw"
                    width="{{ img_d.width }}"
                    height="{{ img_d.height }}"
                    alt="{{ img_d.alt | escape }}"
                    loading="lazy"
                    decoding="async"
                  >
                </picture>
              {%- else -%}
                <div class="cslx__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {%- endif -%}
              </div>
            </div>

            <div class="cslx__content">
              {%- comment -%} ---------- Contenido PC ---------- {%- endcomment -%}
              <div class="cslx__only-desktop">
                {%- if block.settings.heading != blank -%}
                  <{{ s.heading_tag }} class="cslx__heading">{{ block.settings.heading }}</{{ s.heading_tag }}>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="cslx__body">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>

              {%- comment -%} ---------- Contenido móvil ---------- {%- endcomment -%}
              <div class="cslx__only-mobile">
                {%- if s.mobile_content == 'same' -%}
                  {%- if block.settings.heading != blank -%}
                    <{{ s.heading_tag }} class="cslx__heading">{{ block.settings.heading }}</{{ s.heading_tag }}>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="cslx__body">{{ block.settings.text }}</div>
                  {%- endif -%}
                {%- else -%}
                  {%- assign m_heading = block.settings.heading_mobile | default: block.settings.heading -%}
                  {%- if m_heading != blank -%}
                    <{{ s.heading_tag }} class="cslx__heading">{{ m_heading }}</{{ s.heading_tag }}>
                  {%- endif -%}
                  {%- assign bullets = block.settings.bullet_1 | append: block.settings.bullet_2 | append: block.settings.bullet_3 | append: block.settings.bullet_4 | append: block.settings.bullet_5 -%}
                  {%- if bullets != blank -%}
                    <ul class="cslx__list">
                      {%- for i in (1..5) -%}
                        {%- liquid
                          assign key = 'bullet_' | append: i
                          assign item = block.settings[key]
                        -%}
                        {%- if item != blank -%}
                          <li>
                            <span class="cslx__list-icon" aria-hidden="true">
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" fill="none">
                                <path d="M1 12.8213L12.2786 1.54272" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                <path d="M12.3575 12.6636V1.46387H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                              </svg>
                            </span>
                            <span>{{ item }}</span>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if n > 1 -%}
      <div class="cslx__nav" data-nav>
        <div class="cslx__steps" style="--cslx-n: {{ n }};">
          <span class="cslx__steps-line" aria-hidden="true"></span>
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="cslx__step"
              data-step
              data-index="{{ forloop.index0 }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              <span class="cslx__step-dot" aria-hidden="true"></span>
              <span class="cslx__step-label">{{ block.settings.nav_label | default: forloop.index }}</span>
            </button>
          {%- endfor -%}
        </div>

        <div class="cslx__dots">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="cslx__pag"
              data-step
              data-index="{{ forloop.index0 }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="{{ block.settings.nav_label | default: forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>

        <div class="cslx__arrows">
          <button type="button" class="cslx__arrow" data-prev aria-label="{{ s.aria_prev | escape }}">
            <svg viewBox="0 0 9 16" fill="none" aria-hidden="true">
              <path d="M8 1L1.5 8L8 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button type="button" class="cslx__arrow" data-next aria-label="{{ s.aria_next | escape }}">
            <svg viewBox="0 0 9 16" fill="none" aria-hidden="true">
              <path d="M1 1L7.5 8L1 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    {%- endif -%}
  </div>
</cslx-slider>

<script>
  if (!customElements.get('cslx-slider')) {
    customElements.define(
      'cslx-slider',
      class CslxSlider extends HTMLElement {
        connectedCallback() {
          this.stack = this.querySelector('[data-track]');
          this.slides = Array.from(this.querySelectorAll('[data-slide]'));
          if (!this.stack || this.slides.length < 2) return;

          this.steps = Array.from(this.querySelectorAll('[data-step]'));
          this.nav = this.querySelector('[data-nav]');
          this.prevBtn = this.querySelector('[data-prev]');
          this.nextBtn = this.querySelector('[data-next]');
          this.loop = this.dataset.loop === 'true';
          this.index = 0;
          this.supportsInert = 'inert' in HTMLElement.prototype;

          this.steps.forEach((btn) =>
            btn.addEventListener('click', () => this.goTo(Number(btn.dataset.index)))
          );
          if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.goTo(this.index - 1));
          if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.goTo(this.index + 1));

          if (this.nav) {
            this.nav.addEventListener('keydown', (e) => {
              if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
              e.preventDefault();
              this.goTo(this.index + (e.key === 'ArrowRight' ? 1 : -1));
              const focusable = this.steps.filter(
                (b) => Number(b.dataset.index) === this.index && b.offsetParent !== null
              );
              if (focusable.length) focusable[0].focus();
            });
          }

          this.bindSwipe();

          this.blockSelect = (e) => {
            const slide = e.target.closest('[data-slide]');
            if (slide && this.contains(slide)) this.goTo(Number(slide.dataset.index));
          };
          document.addEventListener('shopify:block:select', this.blockSelect);

          this.update();
        }

        disconnectedCallback() {
          document.removeEventListener('shopify:block:select', this.blockSelect);
        }

        bindSwipe() {
          let x0 = null;
          let y0 = null;
          this.stack.addEventListener(
            'touchstart',
            (e) => {
              x0 = e.changedTouches[0].clientX;
              y0 = e.changedTouches[0].clientY;
            },
            { passive: true }
          );
          this.stack.addEventListener(
            'touchend',
            (e) => {
              if (x0 === null) return;
              const dx = e.changedTouches[0].clientX - x0;
              const dy = e.changedTouches[0].clientY - y0;
              // Solo si el gesto es claramente horizontal, para no robar el scroll vertical.
              if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.5) {
                this.goTo(this.index + (dx < 0 ? 1 : -1));
              }
              x0 = null;
              y0 = null;
            },
            { passive: true }
          );
        }

        goTo(i) {
          const total = this.slides.length;
          if (this.loop) {
            i = ((i % total) + total) % total;
          } else {
            i = Math.max(0, Math.min(total - 1, i));
          }
          if (i === this.index) return;

          this.slides[this.index].classList.remove('is-active');
          this.slides[i].classList.add('is-active');
          this.index = i;

          this.update();
        }

        update() {
          this.slides.forEach((slide, i) => {
            const active = i === this.index;
            if (active) {
              slide.removeAttribute('aria-hidden');
            } else {
              slide.setAttribute('aria-hidden', 'true');
            }
            if (this.supportsInert) slide.inert = !active;
          });

          this.steps.forEach((btn) => {
            btn.setAttribute('aria-current', Number(btn.dataset.index) === this.index ? 'true' : 'false');
          });

          if (!this.loop) {
            if (this.prevBtn) this.prevBtn.disabled = this.index === 0;
            if (this.nextBtn) this.nextBtn.disabled = this.index === this.slides.length - 1;
          }
        }
      }
    );
  }
</script>

