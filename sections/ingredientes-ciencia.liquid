{%- comment -%}
  =====================================================================
  SECCIÓN PRO: Ingredientes avalados por la ciencia
  ---------------------------------------------------------------------
  100% editable desde el personalizador:
  - Colores individuales de TODO (sin esquemas de color)
  - Tamaños de texto separados para PC y móvil
  - Espaciados, bordes, radios, sombras, flechas, barra de progreso
  - Pestañas (badges) generadas automáticamente desde los blocks
  - Modal con imagen, descripción y beneficios con flecha ↗
  Archivo: sections/ingredientes-ciencia.liquid
  =====================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{%- style -%}
  #IngSci-{{ section.id }} {
    --is-section-bg: {{ s.section_bg }};
    --is-heading-color: {{ s.heading_color }};
    --is-heading-size: {{ s.heading_size }}px;
    --is-heading-size-m: {{ s.heading_size_mobile }}px;
    --is-heading-weight: {{ s.heading_weight }};
    --is-heading-spacing: {{ s.heading_spacing }}px;

    --is-tab-size: {{ s.tab_font_size }}px;
    --is-tab-size-m: {{ s.tab_font_size_mobile }}px;
    --is-tab-pad-v: {{ s.tab_padding_v }}px;
    --is-tab-pad-h: {{ s.tab_padding_h }}px;
    --is-tab-radius: {{ s.tab_radius }}px;
    --is-tab-gap: {{ s.tab_gap }}px;
    --is-tab-bg: {{ s.tab_bg }};
    --is-tab-text: {{ s.tab_text }};
    --is-tab-border: {{ s.tab_border }};
    --is-tab-active-bg: {{ s.tab_active_bg }};
    --is-tab-active-text: {{ s.tab_active_text }};

    --is-carousel-bg: {{ s.carousel_bg }};
    --is-carousel-radius: {{ s.carousel_radius }}px;
    --is-card-width: {{ s.card_width }}px;
    --is-card-width-m: {{ s.card_width_mobile }}vw;
    --is-card-gap: {{ s.card_gap }}px;
    --is-card-bg: {{ s.card_bg }};
    --is-card-border: {{ s.card_border }};
    --is-card-radius: {{ s.card_radius }}px;
    --is-card-img-radius: {{ s.card_img_radius }}px;

    --is-card-title-size: {{ s.card_title_size }}px;
    --is-card-title-size-m: {{ s.card_title_size_mobile }}px;
    --is-card-title-color: {{ s.card_title_color }};
    --is-card-dosage-size: {{ s.card_dosage_size }}px;
    --is-card-dosage-color: {{ s.card_dosage_color }};
    --is-card-more-size: {{ s.card_more_size }}px;
    --is-card-more-color: {{ s.card_more_color }};

    --is-arrow-color: {{ s.arrow_color }};
    --is-arrow-size: {{ s.arrow_size }}px;

    --is-progress-track: {{ s.progress_track }};
    --is-progress-bar: {{ s.progress_bar }};
    --is-progress-height: {{ s.progress_height }}px;

    --is-overlay: {{ s.modal_overlay_color }};
    --is-overlay-opacity: {{ s.modal_overlay_opacity | divided_by: 100.0 }};
    --is-modal-bg: {{ s.modal_bg }};
    --is-modal-radius: {{ s.modal_radius }}px;
    --is-modal-width: {{ s.modal_width }}px;
    --is-modal-title-size: {{ s.modal_title_size }}px;
    --is-modal-title-color: {{ s.modal_title_color }};
    --is-modal-dosage-color: {{ s.modal_dosage_color }};
    --is-modal-text-size: {{ s.modal_text_size }}px;
    --is-modal-text-color: {{ s.modal_text_color }};
    --is-benefit-size: {{ s.benefit_size }}px;
    --is-benefit-color: {{ s.benefit_color }};
    --is-benefit-icon: {{ s.benefit_icon_color }};
  }

  #IngSci-{{ section.id }} .ing-sci__padding {
    padding-top: {{ s.padding_top_mobile }}px;
    padding-bottom: {{ s.padding_bottom_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #IngSci-{{ section.id }} .ing-sci__padding {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%} Pestañas únicas en orden de aparición {%- endcomment -%}
{%- assign tab_list = '' -%}
{%- for block in section.blocks -%}
  {%- assign t = block.settings.tab | strip -%}
  {%- if t == blank -%}{%- assign t = 'General' -%}{%- endif -%}
  {%- assign existing = tab_list | split: '|||' -%}
  {%- unless existing contains t -%}
    {%- if tab_list == blank -%}
      {%- assign tab_list = t -%}
    {%- else -%}
      {%- assign tab_list = tab_list | append: '|||' | append: t -%}
    {%- endif -%}
  {%- endunless -%}
{%- endfor -%}
{%- assign tabs = tab_list | split: '|||' -%}

<div id="IngSci-{{ section.id }}" class="ing-sci-bg">
  <ingredients-science class="ing-sci {% unless s.full_width %}page-width{% endunless %} ing-sci__padding">

    {%- if s.heading != blank -%}
      <h2 class="ing-sci__heading" style="text-align: {{ s.heading_align }};">
        {{ s.heading }}
      </h2>
    {%- endif -%}

    {%- if tabs.size > 0 and s.show_tabs -%}
      <div class="ing-sci__tabs" role="tablist" aria-label="{{ s.heading | default: 'Ingredientes' | escape }}" style="justify-content: {{ s.tabs_align }};">
        {%- for tab in tabs -%}
          <button
            type="button"
            class="ing-sci__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-tab="{{ tab | handleize }}"
          >
            {{ tab }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="ing-sci__carousel-wrapper">
      {%- if s.show_arrows -%}
        <button type="button" class="ing-sci__arrow ing-sci__arrow--prev" aria-label="Anterior">
          <svg viewBox="0 0 12 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M11 1L1 11L11 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      {%- endif -%}

      <div class="ing-sci__viewport">
        <ul class="ing-sci__track" role="list">
          {%- for block in section.blocks -%}
            {%- assign t = block.settings.tab | strip -%}
            {%- if t == blank -%}{%- assign t = 'General' -%}{%- endif -%}
            {%- assign first_tab = tabs | first -%}
            <li
              class="ing-sci__card-wrap{% unless t == first_tab %} is-hidden{% endunless %}"
              data-tab="{{ t | handleize }}"
              {{ block.shopify_attributes }}
            >
              <button type="button" class="ing-sci__card" aria-haspopup="dialog">
                <div class="ing-sci__card-media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag: loading: 'lazy', widths: '360, 540, 720, 800', sizes: '(min-width: 990px) 300px, 75vw', class: 'ing-sci__card-img'
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'ing-sci__card-img placeholder' }}
                  {%- endif -%}
                </div>
                <div class="ing-sci__card-info">
                  <span class="ing-sci__card-title">{{ block.settings.title }}</span>
                  {%- if block.settings.dosage != blank -%}
                    <span class="ing-sci__card-dosage">{{ block.settings.dosage }}</span>
                  {%- endif -%}
                  {%- if s.more_label != blank -%}
                    <span class="ing-sci__card-more">{{ s.more_label }}</span>
                  {%- endif -%}
                </div>
              </button>

              <template class="ing-sci__modal-template">
                <div class="ing-sci__modal-media">
                  {%- assign modal_img = block.settings.modal_image | default: block.settings.image -%}
                  {%- if modal_img != blank -%}
                    {{ modal_img | image_url: width: 900 | image_tag: loading: 'lazy', class: 'ing-sci__modal-img' }}
                  {%- endif -%}
                </div>
                <div class="ing-sci__modal-head">
                  <div>
                    <h3 class="ing-sci__modal-title">{{ block.settings.title }}</h3>
                    {%- if block.settings.dosage != blank -%}
                      <p class="ing-sci__modal-dosage">{{ block.settings.dosage }}</p>
                    {%- endif -%}
                  </div>
                  <button type="button" class="ing-sci__modal-back" aria-label="Cerrar">
                    <svg width="26" height="16" viewBox="0 0 26 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M8.5 1L1.5 8L8.5 15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                      <path d="M1.5 8H25" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                  </button>
                </div>
                {%- if block.settings.description != blank -%}
                  <div class="ing-sci__modal-desc">{{ block.settings.description }}</div>
                {%- endif -%}
                {%- if block.settings.benefits != blank -%}
                  {%- assign benefits = block.settings.benefits | newline_to_br | split: '<br />' -%}
                  <ul class="ing-sci__modal-benefits" role="list">
                    {%- for benefit in benefits -%}
                      {%- assign b = benefit | strip -%}
                      {%- if b != blank -%}
                        <li>
                          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M1 13L13 1M13 1H3.4M13 1V10.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                          <span>{{ b }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </template>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- if s.show_arrows -%}
        <button type="button" class="ing-sci__arrow ing-sci__arrow--next" aria-label="Siguiente">
          <svg viewBox="0 0 12 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M1 1L11 11L1 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- if s.show_progress -%}
        <div class="ing-sci__progress" aria-hidden="true">
          <div class="ing-sci__progress-bar"></div>
        </div>
      {%- endif -%}
    </div>

    <div class="ing-sci__modal" role="dialog" aria-modal="true" aria-hidden="true" tabindex="-1">
      <div class="ing-sci__modal-overlay" data-close></div>
      <div class="ing-sci__modal-box">
        <div class="ing-sci__modal-content"></div>
      </div>
    </div>

  </ingredients-science>
</div>

<style>
  .ing-sci-bg { background: var(--is-section-bg); }

  .ing-sci__heading {
    margin: 0 0 var(--is-heading-spacing);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--is-heading-weight);
    font-size: var(--is-heading-size-m);
    line-height: 1.1;
    color: var(--is-heading-color);
    letter-spacing: -0.02em;
  }

  /* ---------- Pestañas ---------- */
  .ing-sci__tabs {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--is-tab-gap);
    margin-bottom: 20px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .ing-sci__tabs::-webkit-scrollbar { display: none; }

  .ing-sci__tab {
    flex: 0 0 auto;
    font-family: var(--font-body-family);
    font-size: var(--is-tab-size-m);
    line-height: 1;
    padding: var(--is-tab-pad-v) var(--is-tab-pad-h);
    background: var(--is-tab-bg);
    color: var(--is-tab-text);
    border: 1px solid var(--is-tab-border);
    border-radius: var(--is-tab-radius);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }
  .ing-sci__tab:hover { filter: brightness(0.96); }
  .ing-sci__tab.is-active {
    background: var(--is-tab-active-bg);
    color: var(--is-tab-active-text);
    border-color: var(--is-tab-active-bg);
    font-weight: 500;
  }

  /* ---------- Carrusel ---------- */
  .ing-sci__carousel-wrapper {
    position: relative;
    background: var(--is-carousel-bg);
    border-radius: var(--is-carousel-radius);
    padding: 20px 0 28px;
  }

  .ing-sci__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
  }
  .ing-sci__viewport::-webkit-scrollbar { display: none; }

  .ing-sci__track {
    display: flex;
    gap: var(--is-card-gap);
    list-style: none;
    margin: 0;
    padding: 0 12px;
    width: max-content;
  }

  .ing-sci__card-wrap {
    flex: 0 0 auto;
    width: var(--is-card-width-m);
    scroll-snap-align: start;
  }
  .ing-sci__card-wrap.is-hidden { display: none; }

  .ing-sci__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 10px;
    background: var(--is-card-bg);
    border: 1px solid var(--is-card-border);
    border-radius: var(--is-card-radius);
    cursor: pointer;
    text-align: left;
    font: inherit;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .ing-sci__card:hover {
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  .ing-sci__card-media {
    aspect-ratio: 1 / 1.15;
    overflow: hidden;
    border-radius: var(--is-card-img-radius);
    background: rgba(0, 0, 0, 0.04);
  }
  .ing-sci__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ing-sci__card-info {
    display: flex;
    flex-direction: column;
    padding: 14px 6px 8px;
  }
  .ing-sci__card-title {
    font-size: var(--is-card-title-size-m);
    line-height: 1.25;
    color: var(--is-card-title-color);
  }
  .ing-sci__card-dosage {
    font-size: var(--is-card-dosage-size);
    color: var(--is-card-dosage-color);
    margin-top: 3px;
  }
  .ing-sci__card-more {
    align-self: flex-end;
    font-size: var(--is-card-more-size);
    color: var(--is-card-more-color);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-top: 16px;
  }

  /* ---------- Flechas ---------- */
  .ing-sci__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: calc(var(--is-arrow-size) * 2);
    height: calc(var(--is-arrow-size) * 2);
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--is-arrow-color);
    transition: opacity 0.2s ease;
  }
  .ing-sci__arrow svg { width: calc(var(--is-arrow-size) * 0.55); height: var(--is-arrow-size); }
  .ing-sci__arrow--prev { left: calc(var(--is-arrow-size) * -2.1); }
  .ing-sci__arrow--next { right: calc(var(--is-arrow-size) * -2.1); }
  .ing-sci__arrow[disabled] { opacity: 0.25; cursor: default; }

  @media screen and (max-width: 1200px) {
    .ing-sci__arrow--prev { left: -8px; }
    .ing-sci__arrow--next { right: -8px; }
  }

  /* ---------- Barra de progreso ---------- */
  .ing-sci__progress {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 12px;
    height: var(--is-progress-height);
    background: var(--is-progress-track);
    border-radius: 999px;
    overflow: hidden;
  }
  .ing-sci__progress-bar {
    width: 20%;
    height: 100%;
    background: var(--is-progress-bar);
    border-radius: 999px;
    transform: translateX(0);
    transition: transform 0.15s linear, width 0.15s linear;
  }

  /* ---------- Modal ---------- */
  .ing-sci__modal {
    position: fixed;
    inset: 0;
    z-index: 999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .ing-sci__modal.is-open { display: flex; }

  .ing-sci__modal-overlay {
    position: absolute;
    inset: 0;
    background: var(--is-overlay);
    opacity: var(--is-overlay-opacity);
    animation: ingSciFade 0.25s ease;
  }

  .ing-sci__modal-box {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--is-modal-width);
    max-height: min(86vh, 86dvh);
    overflow-y: auto;
    background: var(--is-modal-bg);
    border-radius: var(--is-modal-radius);
    padding: 20px;
    animation: ingSciUp 0.3s ease;
  }

  @keyframes ingSciFade { from { opacity: 0; } to { opacity: var(--is-overlay-opacity); } }
  @keyframes ingSciUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ing-sci__modal-overlay, .ing-sci__modal-box { animation: none; }
    .ing-sci__viewport { scroll-behavior: auto; }
  }

  .ing-sci__modal-media {
    border-radius: calc(var(--is-modal-radius) * 0.7);
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
    margin-bottom: 18px;
  }
  .ing-sci__modal-img {
    width: 100%;
    height: auto;
    max-height: 260px;
    object-fit: cover;
    display: block;
  }

  .ing-sci__modal-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
  }
  .ing-sci__modal-title {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: var(--is-modal-title-size);
    font-weight: 400;
    line-height: 1.2;
    color: var(--is-modal-title-color);
  }
  .ing-sci__modal-dosage {
    margin: 3px 0 0;
    font-size: calc(var(--is-modal-text-size) + 1px);
    color: var(--is-modal-dosage-color);
  }
  .ing-sci__modal-back {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: var(--is-modal-title-color);
    flex: 0 0 auto;
  }

  .ing-sci__modal-desc {
    margin-top: 16px;
    font-size: var(--is-modal-text-size);
    line-height: 1.6;
    color: var(--is-modal-text-color);
  }
  .ing-sci__modal-desc p { margin: 0 0 8px; }

  .ing-sci__modal-benefits {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ing-sci__modal-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: var(--is-benefit-size);
    line-height: 1.45;
    color: var(--is-benefit-color);
  }
  .ing-sci__modal-benefits svg {
    flex: 0 0 auto;
    margin-top: 4px;
    color: var(--is-benefit-icon);
  }

  body.ing-sci-modal-open { overflow: hidden; }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 750px) {
    .ing-sci__heading { font-size: var(--is-heading-size); }
    .ing-sci__tab { font-size: var(--is-tab-size); }
    .ing-sci__tabs { margin-bottom: 24px; }
    .ing-sci__card-wrap { width: var(--is-card-width); }
    .ing-sci__card-title { font-size: var(--is-card-title-size); }
    .ing-sci__carousel-wrapper { padding: 30px 0 34px; }
    .ing-sci__track { padding: 0 16px; }
  }
  @media screen and (max-width: 749px) {
    .ing-sci__arrow { display: none; }
  }
</style>

<script>
  if (!customElements.get('ingredients-science')) {
    customElements.define(
      'ingredients-science',
      class IngredientsScience extends HTMLElement {
        connectedCallback() {
          this.viewport = this.querySelector('.ing-sci__viewport');
          this.track = this.querySelector('.ing-sci__track');
          this.cards = Array.from(this.querySelectorAll('.ing-sci__card-wrap'));
          this.tabs = Array.from(this.querySelectorAll('.ing-sci__tab'));
          this.prevBtn = this.querySelector('.ing-sci__arrow--prev');
          this.nextBtn = this.querySelector('.ing-sci__arrow--next');
          this.progressBar = this.querySelector('.ing-sci__progress-bar');
          this.modal = this.querySelector('.ing-sci__modal');
          this.modalContent = this.querySelector('.ing-sci__modal-content');
          this.lastFocused = null;

          this.tabs.forEach((tab) => tab.addEventListener('click', () => this.setTab(tab)));
          if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.scrollByCard(-1));
          if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.scrollByCard(1));

          this.viewport.addEventListener('scroll', () => this.updateUI(), { passive: true });
          window.addEventListener('resize', () => this.updateUI());

          this.cards.forEach((wrap) => {
            const card = wrap.querySelector('.ing-sci__card');
            card.addEventListener('click', () => this.openModal(wrap));
          });

          this.modal.addEventListener('click', (e) => {
            if (e.target.hasAttribute('data-close') || e.target.closest('.ing-sci__modal-back')) {
              this.closeModal();
            }
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && this.modal.classList.contains('is-open')) this.closeModal();
          });

          this.updateUI();
        }

        setTab(activeTab) {
          const key = activeTab.dataset.tab;
          this.tabs.forEach((t) => {
            const isActive = t === activeTab;
            t.classList.toggle('is-active', isActive);
            t.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });
          this.cards.forEach((c) => c.classList.toggle('is-hidden', c.dataset.tab !== key));
          this.viewport.scrollTo({ left: 0, behavior: 'auto' });
          this.updateUI();
        }

        visibleCards() {
          return this.cards.filter((c) => !c.classList.contains('is-hidden'));
        }

        scrollByCard(direction) {
          const card = this.visibleCards()[0];
          if (!card) return;
          const gap = parseFloat(getComputedStyle(this.track).gap) || 20;
          const step = card.getBoundingClientRect().width + gap;
          this.viewport.scrollBy({ left: step * direction, behavior: 'smooth' });
        }

        updateUI() {
          const max = this.viewport.scrollWidth - this.viewport.clientWidth;
          const pos = this.viewport.scrollLeft;

          if (this.prevBtn) this.prevBtn.toggleAttribute('disabled', pos <= 2);
          if (this.nextBtn) this.nextBtn.toggleAttribute('disabled', pos >= max - 2);

          if (this.progressBar) {
            if (max <= 0) {
              this.progressBar.style.width = '100%';
              this.progressBar.style.transform = 'translateX(0)';
            } else {
              const ratio = this.viewport.clientWidth / this.viewport.scrollWidth;
              const barWidth = Math.max(ratio * 100, 8);
              const trackWidth = this.progressBar.parentElement.clientWidth;
              const barPx = (barWidth / 100) * trackWidth;
              const x = (pos / max) * (trackWidth - barPx);
              this.progressBar.style.width = barWidth + '%';
              this.progressBar.style.transform = 'translateX(' + x + 'px)';
            }
          }
        }

        openModal(wrap) {
          const template = wrap.querySelector('.ing-sci__modal-template');
          if (!template) return;
          this.lastFocused = document.activeElement;
          this.modalContent.innerHTML = '';
          this.modalContent.appendChild(template.content.cloneNode(true));
          this.modal.classList.add('is-open');
          this.modal.setAttribute('aria-hidden', 'false');
          document.body.classList.add('ing-sci-modal-open');
          const backBtn = this.modal.querySelector('.ing-sci__modal-back');
          if (backBtn) backBtn.focus();
        }

        closeModal() {
          this.modal.classList.remove('is-open');
          this.modal.setAttribute('aria-hidden', 'true');
          document.body.classList.remove('ing-sci-modal-open');
          if (this.lastFocused) this.lastFocused.focus();
        }
      }
    );
  }
</script>

