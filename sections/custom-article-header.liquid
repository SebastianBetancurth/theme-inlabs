      "options": [
        { "value": "solid", "label": "Color plano" },
        { "value": "gradient", "label": "Degradado" }
      ],
      "default": "gradient"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color (relleno plano)",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "heading_gradient_1",
      "label": "Degradado: color inicial",
      "default": "#1e3b31"
    },
    {
      "type": "color",
      "id": "heading_gradient_2",
      "label": "Degradado: color intermedio",
      "default": "#96794a"
    },
    {
      "type": "color",
      "id": "heading_gradient_3",
      "label": "Degradado: color final",
      "default": "#2b2b2b"
    },
    {
      "type": "range",
      "id": "heading_gradient_mid",
      "min": 5,
      "max": 95,
      "step": 5,
      "unit": "%",
      "label": "Degradado: posición del color intermedio",
      "default": 55
    },
    {
      "type": "range",
      "id": "heading_gradient_angle",
      "min": 0,
      "max": 360,
      "step": 5,
      "unit": "°",
      "label": "Degradado: ángulo",
      "default": 90
    },
    {
      "type": "color",
      "id": "em_color",
      "label": "Color del acento <em>",
      "default": "#96794a"
    },
    {
      "type": "checkbox",
      "id": "em_italic",
      "label": "Acento <em> en cursiva",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "label": "Ancho máximo del título — PC",
      "info": "0 = todo el ancho de su columna. Bájalo para forzar dónde parten las líneas.",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_size_d",
      "min": 18,
      "max": 110,
      "step": 1,
      "unit": "px",
      "label": "Tamaño — PC",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_line_height_d",
      "min": 80,
      "max": 200,
      "step": 2,
      "unit": "%",
      "label": "Interlineado — PC",
      "default": 112
    },
    {
      "type": "range",
      "id": "heading_letter_spacing_d",
      "min": -3,
      "max": 6,
      "step": 0.1,
      "unit": "px",
      "label": "Espaciado entre letras — PC",
      "default": -0.5
    },
    {
      "type": "select",
      "id": "heading_align_d",
      "label": "Alineación — PC",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size_m",
      "min": 14,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Tamaño — Móvil",
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_line_height_m",
      "min": 80,
      "max": 200,
      "step": 2,
      "unit": "%",
      "label": "Interlineado — Móvil",
      "default": 118
    },
    {
      "type": "range",
      "id": "heading_letter_spacing_m",
      "min": -3,
      "max": 6,
      "step": 0.1,
      "unit": "px",
      "label": "Espaciado entre letras — Móvil",
      "default": 0
    },
    {
      "type": "select",
      "id": "heading_align_m",
