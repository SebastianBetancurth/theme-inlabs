{%- style -%}
  @font-face {
    font-family: 'thin2';
    src: url('{{ 'lawrence-regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  .benefits-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: 'thin2', sans-serif;
  }
  .benefits-{{ section.id }} .benefits__wrapper {
    max-width: 144rem;
    margin: 0 auto;
    padding: 0 4rem;
  }
  .benefits-{{ section.id }} .benefits__heading {
    margin: 0 0 0.8rem;
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.05;
    color: {{ section.settings.heading_color }};
  }
  .benefits-{{ section.id }} .benefits__intro {
    margin: 0 0 4rem;
    font-size: {{ section.settings.intro_size }}px;
    line-height: 1.45;
    color: {{ section.settings.intro_color }};
    max-width: 72rem;
  }
  .benefits-{{ section.id }} .benefits__intro p {
    margin: 0;
  }
  .benefits-{{ section.id }} .benefits__layout {
    display: flex;
    gap: {{ section.settings.grid_gap }}px;
    align-items: stretch;
    {%- if section.settings.image_position == 'right' -%}
    flex-direction: row-reverse;
    {%- endif -%}
  }
  .benefits-{{ section.id }} .benefits__media {
    flex: 0 0 {{ section.settings.image_width }}%;
    min-width: 0;
    position: relative;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
  }
  .benefits-{{ section.id }} .benefits__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .benefits-{{ section.id }} .benefits__img--mobile {
    display: none !important;
  }
  .benefits-{{ section.id }} .benefits__media-overlay {
    display: none;
  }
  .benefits-{{ section.id }} .benefits__grid {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 1fr;
    gap: {{ section.settings.grid_gap }}px;
    min-width: 0;
  }
  .benefits-{{ section.id }} .benefit-card {
    background: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: 2.4rem 2.4rem 2.8rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .benefits-{{ section.id }} .benefit-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.6rem;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: default;
  }
  .benefits-{{ section.id }} .benefit-card__title {
    margin: 0 0 1.4rem;
    font-size: {{ section.settings.item_title_size }}px;
    font-weight: {% if section.settings.item_title_bold %}700{% else %}400{% endif %};
    line-height: 1.25;
    color: {{ section.settings.card_title_color }};
  }
  .benefits-{{ section.id }} .benefit-card__arrow {
    flex-shrink: 0;
    margin-top: 0.3em;
    transition: transform 0.45s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .benefits-{{ section.id }} .benefit-card__arrow path {
    stroke: {{ section.settings.arrow_color }};
  }
  .benefits-{{ section.id }} .benefit-card__body-inner {
    overflow: hidden;
  }
  .benefits-{{ section.id }} .benefit-card__text {
    margin: 0;
    font-size: {{ section.settings.item_text_size }}px;
    line-height: 1.55;
    color: {{ section.settings.card_text_color }};
  }
  .benefits-{{ section.id }} .benefit-card__text p {
    margin: 0;
  }
  .benefits-{{ section.id }} .benefit-card__text b,
  .benefits-{{ section.id }} .benefit-card__text strong {
    color: {{ section.settings.card_text_bold_color }};
  }
  @media screen and (min-width: 750px) {
    .benefits-{{ section.id }} .benefit-card__body {
      display: block !important;
    }
  }
  @media screen and (max-width: 989px) and (min-width: 750px) {
    .benefits-{{ section.id }} .benefits__layout {
      flex-direction: column;
    }
    .benefits-{{ section.id }} .benefits__media {
      flex: 1 1 auto;
      aspect-ratio: 16 / 10;
    }
  }
  @media screen and (max-width: 749px) {
    .benefits-{{ section.id }} .benefits__wrapper {
      padding: 0 1.2rem;
    }
    .benefits-{{ section.id }} .benefits__header--desktop {
      display: none;
    }
    .benefits-{{ section.id }} .benefits__layout {
      flex-direction: column;
      gap: 1rem;
    }
    .benefits-{{ section.id }} .benefits__media {
      flex: 1 1 auto;
      border-radius: {{ section.settings.image_radius_mobile }}px;
      aspect-ratio: 380 / {{ section.settings.image_height_mobile }};
    }
    {%- if section.settings.image_mobile != blank -%}
    .benefits-{{ section.id }} .benefits__img--desktop {
      display: none !important;
    }
    .benefits-{{ section.id }} .benefits__img--mobile {
      display: block !important;
    }
    {%- endif -%}
    .benefits-{{ section.id }} .benefits__media-overlay {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 1;
      padding: 2rem 1.8rem;
      background: linear-gradient(to bottom, {{ section.settings.overlay_color }} 0%, {{ section.settings.overlay_color | color_modify: 'alpha', 0.45 }} 45%, transparent 75%);
    }
    .benefits-{{ section.id }} .benefits__media-overlay .benefits__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
      margin-bottom: 1rem;
    }
    .benefits-{{ section.id }} .benefits__media-overlay .benefits__intro {
      font-size: {{ section.settings.intro_size_mobile }}px;
      margin-bottom: 0;
    }
    .benefits-{{ section.id }} .benefits__grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .benefits-{{ section.id }} .benefit-card {
      border-radius: {{ section.settings.card_radius_mobile }}px;
      padding: 0;
    }
    .benefits-{{ section.id }} .benefit-card__head {
      cursor: pointer;
      padding: 1.7rem 1.8rem;
      align-items: center;
      -webkit-tap-highlight-color: transparent;
    }
    .benefits-{{ section.id }} .benefit-card__title {
      margin: 0;
      font-size: {{ section.settings.item_title_size_mobile }}px;
    }
    .benefits-{{ section.id }} .benefit-card__arrow {
      margin-top: 0;
    }
    .benefits-{{ section.id }} .benefit-card.is-open .benefit-card__arrow {
      transform: rotate(-135deg);
    }
    .benefits-{{ section.id }} .benefit-card__body {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.45s cubic-bezier(0.32, 0.72, 0, 1);
    }
    .benefits-{{ section.id }} .benefit-card.is-open .benefit-card__body {
      grid-template-rows: 1fr;
    }
    .benefits-{{ section.id }} .benefit-card__text {
      padding: 0 1.8rem 1.8rem;
      font-size: {{ section.settings.item_text_size_mobile }}px;
      opacity: 0;
      transform: translateY(-0.4rem);
      transition: opacity 0.35s ease 0.05s, transform 0.35s ease 0.05s;
    }
    .benefits-{{ section.id }} .benefit-card.is-open .benefit-card__text {
      opacity: 1;
      transform: translateY(0);
    }
  }
{%- endstyle -%}

<div class="benefits-{{ section.id }}" data-benefits>
  <div class="benefits__wrapper">
    <div class="benefits__header--desktop">
      {%- if section.settings.heading != blank -%}
        <h2 class="benefits__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="benefits__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>
    <div class="benefits__layout">
      <div class="benefits__media">
        <div class="benefits__media-overlay">
          {%- if section.settings.heading != blank -%}
            <h2 class="benefits__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <div class="benefits__intro">{{ section.settings.intro }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag: widths: '600, 900, 1400', sizes: '(max-width: 749px) 100vw, 42vw', loading: 'lazy', class: 'benefits__img--desktop'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if section.settings.image_mobile != blank -%}
          {{
            section.settings.image_mobile
            | image_url: width: 900
            | image_tag: widths: '400, 600, 900', sizes: '100vw', loading: 'lazy', class: 'benefits__img--mobile'
          }}
        {%- endif -%}
      </div>
      <div class="benefits__grid">
        {%- for block in section.blocks -%}
          <div class="benefit-card" {{ block.shopify_attributes }}>
            <button type="button" class="benefit-card__head" data-benefit-toggle aria-expanded="false">
              <h3 class="benefit-card__title">{{ block.settings.title }}</h3>
              <svg class="benefit-card__arrow" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 14 14" fill="none">
                <path d="M1 12.8213L12.2786 1.54272" stroke-width="1.5" stroke-linecap="round"></path>
                <path d="M12.3575 12.6636V1.46387H1" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
            </button>
            <div class="benefit-card__body">
              <div class="benefit-card__body-inner">
                <div class="benefit-card__text">{{ block.settings.text }}</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initBenefits(root) {
      if (!root || root.dataset.benefitsInit === 'true') return;
      root.dataset.benefitsInit = 'true';
      var mq = window.matchMedia('(max-width: 749px)');

      root.querySelectorAll('[data-benefit-toggle]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (!mq.matches) return;
          var card = btn.closest('.benefit-card');
          var wasOpen = card.classList.contains('is-open');
          root.querySelectorAll('.benefit-card.is-open').forEach(function(c) {
            c.classList.remove('is-open');
            var b = c.querySelector('[data-benefit-toggle]');
            if (b) b.setAttribute('aria-expanded', 'false');
          });
          if (!wasOpen) {
            card.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      });
    }

    function boot() {
      document.querySelectorAll('[data-benefits]').forEach(initBenefits);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
    document.addEventListener('shopify:section:load', function(e) {
      var el = e.target.querySelector('[data-benefits]');
      if (el) {
        el.dataset.benefitsInit = 'false';
        initBenefits(el);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Beneficios con imagen",
  "tag": "section",
  "class": "section-benefits-image",
  "settings": [
    {
      "type": "header",
      "content": "Imágenes"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen PC"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen móvil",
      "info": "Si se deja vacía, se usa la de PC."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de la imagen (PC)",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Ancho de imagen PC (%)",
      "min": 30,
      "max": 55,
      "step": 1,
      "default": 42
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Altura de imagen móvil",
      "min": 200,
      "max": 480,
      "step": 10,
      "default": 300,
      "info": "Proporción respecto al ancho de pantalla."
    },
    {
      "type": "header",
      "content": "Textos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Potencia tu productividad"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Texto introductorio",
      "default": "<p>Una fórmula <strong>natural</strong>, equilibrada con ingredientes respaldados por la ciencia.</p>"
    },
    {
      "type": "header",
      "content": "Tamaños de texto PC"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Título (px)",
      "min": 28,
      "max": 90,
      "step": 2,
      "default": 52
    },
    {
      "type": "range",
      "id": "intro_size",
      "label": "Texto intro (px)",
      "min": 13,
      "max": 26,
      "step": 1,
      "default": 17
    },
    {
      "type": "range",
      "id": "item_title_size",
      "label": "Título tarjeta (px)",
      "min": 14,
      "max": 32,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "item_text_size",
      "label": "Texto tarjeta (px)",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "header",
      "content": "Tamaños de texto móvil"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Título (px)",
      "min": 18,
      "max": 44,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "intro_size_mobile",
      "label": "Texto intro (px)",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "item_title_size_mobile",
      "label": "Título ítem (px)",
      "min": 13,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "item_text_size_mobile",
      "label": "Texto ítem (px)",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fondo de la sección",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "intro_color",
      "label": "Color del texto intro",
      "default": "#ebebeb"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Fondo de tarjetas",
