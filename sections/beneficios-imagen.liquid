{%- style -%}
  @font-face {
    font-family: 'thin2';
    src: url('{{ 'lawrence-regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  .benefits-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: 'thin2', sans-serif;
    color: #ffffff;
  }
  .benefits-{{ section.id }} .benefits__wrapper {
    max-width: 144rem;
    margin: 0 auto;
    padding: 0 4rem;
  }
  .benefits-{{ section.id }} .benefits__heading {
    margin: 0 0 0.8rem;
    font-family: var(--font-heading-family);
    font-weight: 400;
    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.05;
    color: #ffffff;
  }
  .benefits-{{ section.id }} .benefits__intro {
    margin: 0 0 4rem;
    font-size: {{ section.settings.intro_size }}px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.92);
    max-width: 72rem;
  }
  .benefits-{{ section.id }} .benefits__intro p {
    margin: 0;
  }
  .benefits-{{ section.id }} .benefits__header--mobile {
    display: none;
  }
  .benefits-{{ section.id }} .benefits__layout {
    display: flex;
    gap: 1.2rem;
    align-items: stretch;
  }
  .benefits-{{ section.id }} .benefits__media {
    flex: 0 0 42%;
    min-width: 0;
    position: relative;
    border-radius: 0.6rem;
    overflow: hidden;
  }
  .benefits-{{ section.id }} .benefits__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .benefits-{{ section.id }} .benefits__media-overlay {
    display: none;
  }
  .benefits-{{ section.id }} .benefits__grid {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: 1fr;
    gap: 1.2rem;
    min-width: 0;
  }
  .benefits-{{ section.id }} .benefit-card {
    background: #131313;
    padding: 2.4rem 2.4rem 2.8rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .benefits-{{ section.id }} .benefit-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.6rem;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: default;
  }
  .benefits-{{ section.id }} .benefit-card__title {
    margin: 0 0 1.4rem;
    font-size: {{ section.settings.item_title_size }}px;
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
  }
  .benefits-{{ section.id }} .benefit-card__arrow {
    flex-shrink: 0;
    margin-top: 0.3em;
    transition: transform 0.45s cubic-bezier(0.32, 0.72, 0, 1);
  }
  .benefits-{{ section.id }} .benefit-card__body-inner {
    overflow: hidden;
  }
  .benefits-{{ section.id }} .benefit-card__text {
    margin: 0;
    font-size: {{ section.settings.item_text_size }}px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.85);
  }
  .benefits-{{ section.id }} .benefit-card__text p {
    margin: 0;
  }
  .benefits-{{ section.id }} .benefit-card__text b,
  .benefits-{{ section.id }} .benefit-card__text strong {
    color: #ffffff;
  }
  @media screen and (min-width: 750px) {
    .benefits-{{ section.id }} .benefit-card__body {
      display: block !important;
    }
  }
  @media screen and (max-width: 989px) and (min-width: 750px) {
    .benefits-{{ section.id }} .benefits__layout {
      flex-direction: column;
    }
    .benefits-{{ section.id }} .benefits__media {
      flex: 1 1 auto;
      aspect-ratio: 16 / 10;
    }
  }
  @media screen and (max-width: 749px) {
    .benefits-{{ section.id }} .benefits__wrapper {
      padding: 0 1.2rem;
    }
    .benefits-{{ section.id }} .benefits__header--desktop {
      display: none;
    }
    .benefits-{{ section.id }} .benefits__layout {
      flex-direction: column;
      gap: 1rem;
    }
    .benefits-{{ section.id }} .benefits__media {
      flex: 1 1 auto;
      border-radius: 1.2rem;
      aspect-ratio: 380 / 300;
    }
    .benefits-{{ section.id }} .benefits__media-overlay {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 1;
      padding: 2rem 1.8rem;
      background: linear-gradient(to bottom, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.42) 45%, rgba(0, 0, 0, 0) 75%);
    }
    .benefits-{{ section.id }} .benefits__media-overlay .benefits__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
      margin-bottom: 1rem;
    }
    .benefits-{{ section.id }} .benefits__media-overlay .benefits__intro {
      font-size: {{ section.settings.intro_size_mobile }}px;
      margin-bottom: 0;
    }
    .benefits-{{ section.id }} .benefits__grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .benefits-{{ section.id }} .benefit-card {
      border-radius: 0.8rem;
      padding: 0;
    }
    .benefits-{{ section.id }} .benefit-card__head {
      cursor: pointer;
      padding: 1.7rem 1.8rem;
      align-items: center;
      -webkit-tap-highlight-color: transparent;
    }
    .benefits-{{ section.id }} .benefit-card__title {
      margin: 0;
      font-size: {{ section.settings.item_title_size_mobile }}px;
    }
    .benefits-{{ section.id }} .benefit-card__arrow {
      margin-top: 0;
    }
    .benefits-{{ section.id }} .benefit-card.is-open .benefit-card__arrow {
      transform: rotate(-135deg);
    }
    .benefits-{{ section.id }} .benefit-card__body {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.45s cubic-bezier(0.32, 0.72, 0, 1);
    }
    .benefits-{{ section.id }} .benefit-card.is-open .benefit-card__body {
      grid-template-rows: 1fr;
    }
    .benefits-{{ section.id }} .benefit-card__text {
      padding: 0 1.8rem 1.8rem;
      font-size: {{ section.settings.item_text_size_mobile }}px;
      opacity: 0;
      transform: translateY(-0.4rem);
      transition: opacity 0.35s ease 0.05s, transform 0.35s ease 0.05s;
    }
    .benefits-{{ section.id }} .benefit-card.is-open .benefit-card__text {
      opacity: 1;
      transform: translateY(0);
    }
  }
{%- endstyle -%}

<div class="benefits-{{ section.id }}" data-benefits>
  <div class="benefits__wrapper">
    <div class="benefits__header--desktop">
      {%- if section.settings.heading != blank -%}
        <h2 class="benefits__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="benefits__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>
    <div class="benefits__layout">
      <div class="benefits__media">
        <div class="benefits__media-overlay">
          {%- if section.settings.heading != blank -%}
            <h2 class="benefits__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <div class="benefits__intro">{{ section.settings.intro }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag: widths: '600, 900, 1400', sizes: '(max-width: 749px) 100vw, 42vw', loading: 'lazy'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="benefits__grid">
        {%- for block in section.blocks -%}
          <div class="benefit-card" {{ block.shopify_attributes }}>
            <button type="button" class="benefit-card__head" data-benefit-toggle aria-expanded="false">
              <h3 class="benefit-card__title">{{ block.settings.title }}</h3>
              <svg class="benefit-card__arrow" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 14 14" fill="none">
                <path d="M1 12.8213L12.2786 1.54272" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"></path>
                <path d="M12.3575 12.6636V1.46387H1" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"></path>
              </svg>
            </button>
            <div class="benefit-card__body">
              <div class="benefit-card__body-inner">
                <div class="benefit-card__text">{{ block.settings.text }}</div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initBenefits(root) {
      if (!root || root.dataset.benefitsInit === 'true') return;
      root.dataset.benefitsInit = 'true';
      var mq = window.matchMedia('(max-width: 749px)');

      root.querySelectorAll('[data-benefit-toggle]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (!mq.matches) return;
          var card = btn.closest('.benefit-card');
          var wasOpen = card.classList.contains('is-open');
          root.querySelectorAll('.benefit-card.is-open').forEach(function(c) {
            c.classList.remove('is-open');
            var b = c.querySelector('[data-benefit-toggle]');
            if (b) b.setAttribute('aria-expanded', 'false');
          });
          if (!wasOpen) {
            card.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      });
    }

    function boot() {
      document.querySelectorAll('[data-benefits]').forEach(initBenefits);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
    document.addEventListener('shopify:section:load', function(e) {
      var el = e.target.querySelector('[data-benefits]');
      if (el) {
        el.dataset.benefitsInit = 'false';
        initBenefits(el);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Beneficios con imagen",
  "tag": "section",
  "class": "section-benefits-image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Potencia tu productividad"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Texto introductorio",
      "default": "<p>Una fórmula <strong>natural</strong>, equilibrada con ingredientes respaldados por la ciencia.</p>"
    },
    {
      "type": "header",
      "content": "Tamaños de texto PC"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Título (px)",
      "min": 28,
      "max": 90,
      "step": 2,
      "default": 52
    },
    {
      "type": "range",
      "id": "intro_size",
      "label": "Texto intro (px)",
      "min": 13,
      "max": 26,
      "step": 1,
      "default": 17
    },
    {
      "type": "range",
      "id": "item_title_size",
      "label": "Título tarjeta (px)",
      "min": 14,
      "max": 32,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "item_text_size",
      "label": "Texto tarjeta (px)",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "header",
      "content": "Tamaños de texto móvil"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Título (px)",
      "min": 18,
      "max": 44,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "intro_size_mobile",
      "label": "Texto intro (px)",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "item_title_size_mobile",
      "label": "Título ítem (px)",
      "min": 13,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "item_text_size_mobile",
      "label": "Texto ítem (px)",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "header",
      "content": "Estilo"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Título del beneficio"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Descripción",
          "default": "<p>Descripción corta del beneficio.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Beneficios con imagen",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}