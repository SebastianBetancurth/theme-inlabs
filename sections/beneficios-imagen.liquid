      "min": 4,
      "max": 32,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Redondeo tarjetas PC (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "card_radius_mobile",
      "label": "Redondeo tarjetas móvil (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Redondeo imagen PC (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 6
    },
    {
      "type": "range",
      "id": "image_radius_mobile",
      "label": "Redondeo imagen móvil (px)",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Título del beneficio"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Descripción",
          "default": "<p>Descripción corta del beneficio.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Beneficios con imagen",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}