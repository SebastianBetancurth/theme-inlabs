      "options": [
        { "value": "9 / 16", "label": "9:16 — retrato alto" },
        { "value": "2 / 3", "label": "2:3 — retrato" },
        { "value": "3 / 4", "label": "3:4 — retrato suave" },
        { "value": "4 / 5", "label": "4:5 — retrato corto" },
        { "value": "1 / 1", "label": "1:1 — cuadrada" },
