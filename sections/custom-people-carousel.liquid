    },
    {
      "type": "range",
      "id": "name_offset_d",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Distancia al borde — PC",
      "info": "Desde abajo, desde arriba o el hueco con la foto, según la posición elegida.",
      "default": 34
    },
    {
      "type": "range",
      "id": "name_offset_m",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Distancia al borde — Móvil",
      "default": 22
    },
    {
      "type": "range",
      "id": "name_padding_x_d",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Margen lateral del nombre — PC",
      "info": "Evita que un nombre largo toque los bordes de la foto.",
      "default": 16
