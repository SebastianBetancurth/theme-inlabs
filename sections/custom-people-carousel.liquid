      "label": "Alineación",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "name_size_d",
      "min": 12,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Tamaño — PC",
      "default": 36
    },
    {
      "type": "range",
      "id": "name_size_m",
      "min": 10,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Tamaño — Móvil",
      "default": 24
    },
    {
      "type": "range",
      "id": "name_line_height",
      "min": 0.9,
      "max": 2,
      "step": 0.1,
      "label": "Interlineado",
      "default": 1.1
    },
    {
      "type": "range",
      "id": "name_letter_spacing",
      "min": -2,
      "max": 6,
      "step": 0.5,
      "unit": "px",
      "label": "Espaciado entre letras",
