      "default": "9 / 16"
    },
    {
      "type": "select",
      "id": "ratio_m",
      "label": "Proporción de la tarjeta — Móvil",
      "options": [
        { "value": "9 / 16", "label": "9:16 — retrato alto" },
        { "value": "2 / 3", "label": "2:3 — retrato" },
        { "value": "3 / 4", "label": "3:4 — retrato suave" },
        { "value": "4 / 5", "label": "4:5 — retrato corto" },
        { "value": "1 / 1", "label": "1:1 — cuadrada" },
        { "value": "4 / 3", "label": "4:3 — horizontal" },
        { "value": "16 / 9", "label": "16:9 — panorámica" },
        { "value": "custom", "label": "Personalizada (abajo)" }
      ],
      "default": "9 / 16"
    },
    {
      "type": "text",
      "id": "ratio_custom_m",
      "label": "Proporción personalizada — Móvil",
      "default": "9 / 16"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Ajuste de la imagen",
