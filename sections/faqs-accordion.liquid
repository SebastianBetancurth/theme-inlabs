{% comment %}
  ============================================================
  SECCIÓN: FAQs con acordeón animado
  Theme: Dawn (compatible con cualquier theme OS 2.0)
  Archivo: sections/faqs-accordion.liquid
  ------------------------------------------------------------
  - Título grande (ej: "FAQs") + subtítulo con enlace opcional.
  - Cada pregunta es un bloque: pregunta + respuesta (richtext).
  - Acordeón con apertura/cierre ANIMADO suave (técnica de
    grid-template-rows 0fr -> 1fr, sin max-height hardcodeado).
  - Chevron que rota al abrir.
  - Opción "solo una abierta a la vez".
  - Líneas divisorias finas entre preguntas.
  - Todo editable: colores, textos, tamaños, paddings y
    márgenes separados escritorio/móvil.
  ============================================================
{% endcomment %}

{%- liquid
  assign sid = section.id
-%}

{%- style -%}
  #shopify-section-{{ sid }} .zf-section {
    display: block;
    --zf-bg: {{ section.settings.color_bg }};
    --zf-heading: {{ section.settings.color_heading }};
    --zf-subtext: {{ section.settings.color_subtext }};
    --zf-question: {{ section.settings.color_question }};
    --zf-answer: {{ section.settings.color_answer }};
    --zf-line: {{ section.settings.color_line }};
    --zf-chevron: {{ section.settings.color_chevron }};
    --zf-heading-size: {{ section.settings.heading_size }}px;
    --zf-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --zf-question-size: {{ section.settings.question_size }}px;
    --zf-question-size-mobile: {{ section.settings.question_size_mobile }}px;
    --zf-max-width: {{ section.settings.max_width }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    background: var(--zf-bg);
    font-family: var(--font-body-family);
  }

  #shopify-section-{{ sid }} .zf-wrapper {
    max-width: var(--zf-max-width);
    margin: 0 auto;
    padding: 0 {{ section.settings.padding_x }}px;
  }

  /* ============ ENCABEZADO ============ */
  #shopify-section-{{ sid }} .zf-heading {
    font-family: "thin2", var(--font-heading-family), serif;
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: var(--zf-heading-size);
    line-height: 1.05;
    color: var(--zf-heading);
    margin: 0 0 1.2rem;
  }
  #shopify-section-{{ sid }} .zf-subtext {
    font-size: 1.5rem;
    line-height: 1.5;
    color: var(--zf-subtext);
    margin: 0 0 {{ section.settings.gap_heading }}px;
  }
  #shopify-section-{{ sid }} .zf-subtext a {
    color: var(--zf-subtext);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ============ ACORDEÓN ============ */
  #shopify-section-{{ sid }} .zf-item {
    border-bottom: 1px solid var(--zf-line);
  }
  #shopify-section-{{ sid }} .zf-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.4rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    text-align: left;
    padding: {{ section.settings.question_padding }}px 0;
    font-family: 'Helvetica neue';
    font-size: var(--zf-question-size);
    line-height: 1.35;
    color: var(--zf-question);
  }
  #shopify-section-{{ sid }} .zf-question:hover { opacity: .8; }
  #shopify-section-{{ sid }} .zf-chevron {
    flex: 0 0 auto;
    width: 1.6rem;
    height: 1rem;
    color: var(--zf-chevron);
    transition: transform .35s cubic-bezier(.22, .9, .32, 1);
  }
  #shopify-section-{{ sid }} .zf-item.is-open .zf-chevron {
    transform: rotate(180deg);
  }

  /* Apertura animada: grid-rows 0fr -> 1fr (altura automática) */
  #shopify-section-{{ sid }} .zf-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows .4s cubic-bezier(.22, .9, .32, 1);
  }
  #shopify-section-{{ sid }} .zf-item.is-open .zf-answer {
    grid-template-rows: 1fr;
  }
  #shopify-section-{{ sid }} .zf-answer-inner {
    overflow: hidden;
    min-height: 0;
  }
  #shopify-section-{{ sid }} .zf-answer-content {
    font-size: 1.5rem;
    line-height: 1.6;
    color: var(--zf-answer);
    padding: 0 3rem 2.2rem 0;
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity .35s ease .08s, transform .35s ease .08s;
  }
  #shopify-section-{{ sid }} .zf-item.is-open .zf-answer-content {
    opacity: 1;
    transform: none;
  }
  #shopify-section-{{ sid }} .zf-answer-content p { margin: 0 0 1rem; }
  #shopify-section-{{ sid }} .zf-answer-content p:last-child { margin-bottom: 0; }
  #shopify-section-{{ sid }} .zf-answer-content a {
    color: var(--zf-answer);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ============ MOBILE ============ */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ sid }} .zf-section {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      margin-top: {{ section.settings.margin_top_mobile }}px;
      margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    }
    #shopify-section-{{ sid }} .zf-wrapper {
      padding: 0 {{ section.settings.padding_x_mobile }}px;
    }
    #shopify-section-{{ sid }} .zf-heading {
      font-size: var(--zf-heading-size-mobile);
    }
    #shopify-section-{{ sid }} .zf-subtext {
      margin-bottom: {{ section.settings.gap_heading_mobile }}px;
    }
    #shopify-section-{{ sid }} .zf-question {
      font-size: var(--zf-question-size-mobile);
      padding: {{ section.settings.question_padding_mobile }}px 0;
      gap: 1.6rem;
    }
    #shopify-section-{{ sid }} .zf-answer-content {
      padding-right: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .zf-answer,
    #shopify-section-{{ sid }} .zf-answer-content,
    #shopify-section-{{ sid }} .zf-chevron {
      transition: none;
    }
  }
{%- endstyle -%}

<zi-faqs class="zf-section" data-section-id="{{ sid }}" {% if section.settings.single_open %}data-single{% endif %}>
  <div class="zf-wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="zf-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p class="zf-subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}

    <div class="zf-list">
      {%- for block in section.blocks -%}
        <div class="zf-item" data-item {{ block.shopify_attributes }}>
          <button
            type="button"
            class="zf-question"
            data-toggle
            aria-expanded="false"
            aria-controls="ZfAnswer-{{ sid }}-{{ forloop.index }}"
          >
            <span>{{ block.settings.question | escape }}</span>
            <svg class="zf-chevron" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M1 1L8 8.5L15 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="zf-answer" id="ZfAnswer-{{ sid }}-{{ forloop.index }}">
            <div class="zf-answer-inner">
              <div class="zf-answer-content">{{ block.settings.answer }}</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</zi-faqs>

<script>
  if (!customElements.get('zi-faqs')) {
    customElements.define(
      'zi-faqs',
      class ZiFaqs extends HTMLElement {
        connectedCallback() {
          this.items = Array.from(this.querySelectorAll('[data-item]'));
          this.single = this.hasAttribute('data-single');

          this.items.forEach((item) => {
            const btn = item.querySelector('[data-toggle]');
            btn.addEventListener('click', () => {
              const isOpen = item.classList.contains('is-open');
              if (this.single && !isOpen) {
                /* Cerrar las demás antes de abrir esta */
                this.items.forEach((other) => {
                  if (other !== item) this.close(other);
                });
              }
              if (isOpen) {
                this.close(item);
              } else {
                this.open(item);
              }
            });
          });
        }

        open(item) {
          item.classList.add('is-open');
          const btn = item.querySelector('[data-toggle]');
          if (btn) btn.setAttribute('aria-expanded', 'true');
        }

        close(item) {
          item.classList.remove('is-open');
          const btn = item.querySelector('[data-toggle]');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "FAQs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "FAQs"
    },
    {
      "type": "inline_richtext",
      "id": "subtext",
      "label": "Subtítulo",
      "info": "Podés incluir un enlace, ej: escribirnos <a href=\"/pages/contacto\">aquí</a>",
      "default": "Si tienes alguna duda adicional puedes escribirnos aquí"
    },
    {
      "type": "checkbox",
      "id": "single_open",
      "label": "Solo una pregunta abierta a la vez",
      "default": false
    },
    {
      "type": "header",
      "content": "Tamaños"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título (escritorio)",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Tamaño del título (móvil)",
      "min": 18,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "question_size",
      "label": "Tamaño de las preguntas (escritorio)",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "question_size_mobile",
      "label": "Tamaño de las preguntas (móvil)",
      "min": 12,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "question_padding",
      "label": "Alto de cada pregunta (escritorio)",
      "min": 10,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "question_padding_mobile",
      "label": "Alto de cada pregunta (móvil)",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo del contenido",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 940
    },
    {
      "type": "header",
      "content": "Espaciado (escritorio)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding superior",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding inferior",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Padding lateral",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margen superior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margen inferior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap_heading",
      "label": "Espacio bajo el subtítulo",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Espaciado (móvil)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding superior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding inferior",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "Padding lateral",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Margen superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Margen inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap_heading_mobile",
      "label": "Espacio bajo el subtítulo",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fondo de la sección",
      "default": "#0B0B0B"
    },
    {
      "type": "color",
      "id": "color_heading",
      "label": "Título",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_subtext",
      "label": "Subtítulo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_question",
      "label": "Preguntas",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_answer",
      "label": "Respuestas",
      "default": "#D6D6D6"
    },
    {
      "type": "color",
      "id": "color_line",
      "label": "Líneas divisorias",
      "default": "#3A3A3A"
    },
    {
      "type": "color",
      "id": "color_chevron",
      "label": "Flechas (chevrons)",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pregunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pregunta",
          "default": "¿Qué diferencia a nuestra marca de otras?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Respuesta",
          "default": "<p>Escribí aquí la respuesta a la pregunta.</p>"
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "FAQs",
      "blocks": [
        { "type": "faq", "settings": { "question": "¿Qué diferencia a ZZEN de otras marcas?" } },
        { "type": "faq", "settings": { "question": "¿Las fórmulas generan dependencia?" } },
        { "type": "faq", "settings": { "question": "¿Las dosis son adecuadas?" } },
        { "type": "faq", "settings": { "question": "¿Existen efectos secundarios?" } },
        { "type": "faq", "settings": { "question": "¿Cuánto tiempo tarda el envío?" } }
      ]
    }
  ]
}
{% endschema %}
