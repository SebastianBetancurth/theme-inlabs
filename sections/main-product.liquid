            { "value": "auto", "label": "Compartir línea" }
          ],
          "default": "full"
        },
        {
          "type": "range",
          "id": "order_mobile",
          "label": "Orden en móvil",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 1
        },
        {
          "type": "checkbox",
          "id": "push_right_mobile",
          "label": "Empujar a la derecha (móvil)",
          "default": false
        },
        {
          "type": "select",
          "id": "layout_desktop",
          "label": "Ancho en escritorio",
          "options": [
            { "value": "full", "label": "Línea propia" },
            { "value": "auto", "label": "Compartir línea" }
          ],
          "default": "full"
        },
        {
          "type": "range",
          "id": "order_desktop",
          "label": "Orden en escritorio",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 1
        },
        {
          "type": "checkbox",
          "id": "push_right_desktop",
          "label": "Empujar a la derecha (escritorio)",
          "default": false
        },
      ]
    },
    {
  "type": "zzen_note",
  "name": "— Nota / texto auxiliar",
  "settings": [
    {
      "type": "checkbox",
      "id": "hoist_mobile",
      "label": "Mostrar arriba de la galería en móvil",
      "default": false,
      "info": "Actívalo para el aviso que va sobre las imágenes. Déjalo desactivado para el texto de debajo del botón."
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Texto",
      "default": "Recomendamos tomarlo mínimo 3 meses para resultados óptimos",
      "info": "Déjalo vacío para ocultar el bloque. Admite negrita, cursiva, enlaces y metacampos vía fuente dinámica."
    },
    {
      "type": "header",
      "content": "Icono"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icono integrado",
      "options": [
        { "value": "none", "label": "Sin icono" },
        { "value": "info", "label": "Información" },
        { "value": "check", "label": "Check" },
        { "value": "clock", "label": "Reloj" },
        { "value": "leaf", "label": "Hoja" },
        { "value": "truck", "label": "Camión" },
        { "value": "shield", "label": "Escudo" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Icono propio (SVG/PNG)",
      "info": "Sustituye al icono integrado."
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Posición del icono",
      "options": [
        { "value": "before", "label": "Antes del texto" },
        { "value": "after", "label": "Después del texto" }
      ],
      "default": "before"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Color del icono",
      "default": "#8A8A8A"
    },
    {
      "type": "header",
      "content": "Visibilidad"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Mostrar en escritorio",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Mostrar en móvil",
      "default": true
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Fuente",
      "options": [
        { "value": "body", "label": "Fuente de texto del tema" },
        { "value": "heading", "label": "Fuente de títulos del tema" },
        { "value": "custom", "label": "Personalizada" }
      ],
      "default": "body"
    },
    {
      "type": "text",
      "id": "custom_font_stack",
      "label": "Stack CSS personalizado",
      "default": "'Helvetica Neue', Helvetica, Arial, sans-serif",
      "info": "Solo se aplica si eliges «Personalizada». Incluye fuentes de respaldo."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#8A8A8A"
    },
    {
      "type": "select",
      "id": "text_weight",
