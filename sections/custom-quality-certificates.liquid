{%- comment -%}
  ============================================================================
  SECCIÓN: Certificados internacionales de calidad
  Tema: Dawn / Online Store 2.0
  Ruta: sections/custom-quality-certificates.liquid

  PC     -> dos columnas. El título a la izquierda, en varias líneas, y a la
            derecha una fila de tarjetas oscuras con el nombre del certificado
            arriba y la descripción debajo. Todas las tarjetas de una misma
            fila crecen hasta el alto de la más larga.
  Móvil  -> el título pasa arriba y las tarjetas se reparten en dos columnas,
            dos filas.

  NO LLEVA JAVASCRIPT.
  Es una rejilla estática: no hay carrusel, ni acordeón, ni nada que necesite
  script. Cuantas menos cosas se muevan, menos hay que arreglar después.

  LOS ALTOS IGUALES SON GRATIS.
  Las tarjetas van en CSS Grid, y en una rejilla todas las celdas de una fila
  miden lo mismo por defecto. No hace falta medir alturas con JS ni fijar un
  alto mínimo a ojo. El ajuste de "alto mínimo" del personalizador está solo
  por si quieres tarjetas más cuadradas de lo que pide el texto.

  EL NÚMERO DE COLUMNAS SE ESCRIBE DESDE LIQUID, NO CON UNA VARIABLE CSS.
  Se genera el `repeat(...)` completo aquí abajo en vez de meter el número en
  una variable y usarla dentro de `repeat()`. Esa segunda forma falla en
  navegadores antiguos y no hay motivo para arriesgarse: el CSS ya se compila
  por sección.
  ============================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign bp = s.mobile_breakpoint
  assign bp_max = bp | minus: 1

  case s.heading_font
    when 'thin2'
      assign heading_stack = "'thin2', 'Times New Roman', Georgia, serif"
    when 'helvetica'
      assign heading_stack = "'Helvetica neue', Helvetica, Arial, sans-serif"
    when 'theme_heading'
      assign heading_stack = 'var(--font-heading-family)'
    when 'theme_body'
      assign heading_stack = 'var(--font-body-family)'
    else
      assign heading_stack = s.heading_font_custom
  endcase

  case s.body_font
    when 'thin2'
      assign body_stack = "'thin2', 'Times New Roman', Georgia, serif"
    when 'helvetica'
      assign body_stack = "'Helvetica neue', Helvetica, Arial, sans-serif"
    when 'theme_heading'
      assign body_stack = 'var(--font-heading-family)'
    when 'theme_body'
      assign body_stack = 'var(--font-body-family)'
    else
      assign body_stack = s.body_font_custom
  endcase

  if s.content_max_width == 0
    assign max_w = 'none'
  else
    assign max_w = s.content_max_width | append: 'px'
  endif

  if s.em_italic
    assign em_style = 'italic'
  else
    assign em_style = 'normal'
  endif

  if s.title_uppercase
    assign title_transform = 'uppercase'
  else
    assign title_transform = 'none'
  endif

  # La imagen es un elemento flex: no le llega el text-align de la tarjeta, así
  # que su alineación se traduce a mano.
  case s.card_align_d
    when 'center'
      assign img_self_d = 'center'
    when 'right'
      assign img_self_d = 'flex-end'
    else
      assign img_self_d = 'flex-start'
  endcase

  case s.card_align_m
    when 'center'
      assign img_self_m = 'center'
    when 'right'
      assign img_self_m = 'flex-end'
    else
      assign img_self_m = 'flex-start'
  endcase

  # Rejilla de tarjetas: se arma la plantilla completa. Ver nota de cabecera.
  assign cols_tpl_d = 'repeat(' | append: s.cols_d | append: ', minmax(0, 1fr))'
  assign cols_tpl_m = 'repeat(' | append: s.cols_m | append: ', minmax(0, 1fr))'

  # Reparto de las dos columnas de PC. El título manda su ancho y las tarjetas
  # se quedan con el resto.
  assign head_w = s.head_width_d | append: '%'
-%}

{%- style -%}
  @font-face {
    font-family: 'Helvetica neue';
    src: url('{{ 'HelveticaNeueCyr-Light.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'thin2';
    src: url('{{ 'lawrence-regular.woff2' | asset_url }}') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  /* ================= Variables: PC ================= */
  .zcert-{{ section.id }} {
    --zc-bg: {{ s.bg_color }};
    --zc-max-w: {{ max_w }};
    --zc-pt: {{ s.padding_top_d }}px;
    --zc-pb: {{ s.padding_bottom_d }}px;
    --zc-pl: {{ s.padding_left_d }}px;
    --zc-pr: {{ s.padding_right_d }}px;

    --zc-head-w: {{ head_w }};
    --zc-layout-cols: {{ head_w }} minmax(0, 1fr);
    --zc-layout-gap: {{ s.layout_gap_d }}px;
    --zc-head-valign: {{ s.head_valign_d }};

    --zc-h-font: {{ heading_stack }};
    --zc-h-size: {{ s.heading_size_d }}px;
    --zc-h-lh: {{ s.heading_line_height_d | divided_by: 100.0 }};
    --zc-h-ls: {{ s.heading_letter_spacing_d }}px;
    --zc-h-weight: {{ s.heading_weight }};
    --zc-h-color: {{ s.heading_color }};
    --zc-h-align: {{ s.heading_align_d }};
    --zc-h-max-w: {{ s.heading_max_width_d }}%;
    --zc-h-mb: {{ s.heading_margin_bottom_d }}px;
    --zc-em-color: {{ s.em_color }};
    --zc-em-style: {{ em_style }};

    --zc-sub-size: {{ s.sub_size_d }}px;
    --zc-sub-lh: {{ s.sub_line_height | divided_by: 100.0 }};
    --zc-sub-color: {{ s.sub_color }};
    --zc-sub-mt: {{ s.sub_margin_top_d }}px;
    --zc-sub-max-w: {{ s.sub_max_width_d }}%;

    --zc-b-font: {{ body_stack }};

    --zc-cards-cols: {{ cols_tpl_d }};
    --zc-col-gap: {{ s.col_gap_d }}px;
    --zc-row-gap: {{ s.row_gap_d }}px;

    --zc-card-bg: {{ s.card_bg }};
    --zc-card-bg-hover: {{ s.card_bg_hover }};
    --zc-card-border: {{ s.card_border_color }};
    --zc-card-border-hover: {{ s.card_border_color_hover }};
    --zc-card-border-w: {{ s.card_border_width }}px;
    --zc-card-radius: {{ s.card_radius_d }}px;
    --zc-card-px: {{ s.card_padding_x_d }}px;
    --zc-card-py: {{ s.card_padding_y_d }}px;
    --zc-card-min-h: {{ s.card_min_height_d }}px;
    --zc-card-align: {{ s.card_align_d }};
    --zc-card-justify: {{ s.card_justify }};
    --zc-card-lift: {{ s.card_hover_lift }}px;

    --zc-img-w: {{ s.image_width_d }}px;
    --zc-img-mb: {{ s.image_margin_bottom_d }}px;
    --zc-img-radius: {{ s.image_radius }}px;
    --zc-img-self: {{ img_self_d }};

    --zc-t-size: {{ s.title_size_d }}px;
    --zc-t-lh: {{ s.title_line_height | divided_by: 100.0 }};
    --zc-t-ls: {{ s.title_letter_spacing }}px;
    --zc-t-weight: {{ s.title_weight }};
    --zc-t-color: {{ s.title_color }};
    --zc-t-tt: {{ title_transform }};
    --zc-t-mb: {{ s.title_margin_bottom_d }}px;

    --zc-x-size: {{ s.text_size_d }}px;
    --zc-x-lh: {{ s.text_line_height_d | divided_by: 100.0 }};
    --zc-x-ls: {{ s.text_letter_spacing }}px;
    --zc-x-weight: {{ s.text_weight }};
    --zc-x-color: {{ s.text_color }};

    --zc-anim: {{ s.transition_ms }}ms;
  }

  /* ================= Estructura ================= */
  .zcert {
    background-color: var(--zc-bg);
  }

  .zcert__inner {
    max-width: var(--zc-max-w);
    margin-inline: auto;
    padding: var(--zc-pt) var(--zc-pr) var(--zc-pb) var(--zc-pl);
    box-sizing: border-box;
  }

  /* Dos columnas: título y tarjetas. El título se pega arriba, al centro o
     abajo de su columna según el ajuste. */
  .zcert__layout {
    display: grid;
    grid-template-columns: var(--zc-layout-cols);
    gap: var(--zc-layout-gap);
  }

  .zcert__layout--stacked {
    grid-template-columns: minmax(0, 1fr);
  }

  .zcert__layout--right {
    grid-template-columns: minmax(0, 1fr) var(--zc-head-w);
  }

  .zcert__head {
    align-self: var(--zc-head-valign);
    min-width: 0;
  }

  /* El margen inferior del título solo hace falta cuando va encima de las
     tarjetas. En dos columnas lo separa el gap de la rejilla. */
  .zcert__layout--stacked .zcert__head {
    margin-bottom: var(--zc-h-mb);
  }

  .zcert__layout--right .zcert__head {
    order: 2;
  }

  /* ================= Título ================= */
  .zcert__heading {
    margin: 0;
    max-width: var(--zc-h-max-w);
    font-family: var(--zc-h-font);
    font-size: var(--zc-h-size);
    font-weight: var(--zc-h-weight);
    line-height: var(--zc-h-lh);
    letter-spacing: var(--zc-h-ls);
    text-align: var(--zc-h-align);
    color: var(--zc-h-color);
  }

  .zcert__heading em,
  .zcert__heading i {
    font-style: var(--zc-em-style);
    color: var(--zc-em-color);
  }

  .zcert__sub {
    margin: var(--zc-sub-mt) 0 0;
    max-width: var(--zc-sub-max-w);
    font-family: var(--zc-b-font);
    font-size: var(--zc-sub-size);
    line-height: var(--zc-sub-lh);
    text-align: var(--zc-h-align);
    color: var(--zc-sub-color);
  }

  .zcert__sub > * {
    margin: 0;
  }

  .zcert__sub > * + * {
    margin-top: 0.7em;
  }

  /* ================= Rejilla de tarjetas ================= */
  .zcert__cards {
    display: grid;
    grid-template-columns: var(--zc-cards-cols);
    column-gap: var(--zc-col-gap);
    row-gap: var(--zc-row-gap);
    min-width: 0;
  }

  .zcert__card {
    display: flex;
    flex-direction: column;
    justify-content: var(--zc-card-justify);
    box-sizing: border-box;
    min-height: var(--zc-card-min-h);
    padding: var(--zc-card-py) var(--zc-card-px);
    border: var(--zc-card-border-w) solid var(--zc-card-border);
    border-radius: var(--zc-card-radius);
    background-color: var(--zc-card-bg);
    text-align: var(--zc-card-align);
    transition: background-color var(--zc-anim) ease, border-color var(--zc-anim) ease,
      transform var(--zc-anim) ease;
  }

  /* Solo cuando la tarjeta lleva enlace. Un div no reacciona al ratón. */
  a.zcert__card {
    text-decoration: none;
    color: inherit;
  }

  a.zcert__card:hover {
    background-color: var(--zc-card-bg-hover);
    border-color: var(--zc-card-border-hover);
    transform: translateY(calc(var(--zc-card-lift) * -1));
  }

  a.zcert__card:focus-visible {
    outline: 2px solid var(--zc-t-color);
    outline-offset: 3px;
  }

  /* La imagen no hereda text-align, así que se alinea por su cuenta con el
     mismo criterio que el texto de la tarjeta. */
  .zcert__card-img {
    display: block;
    align-self: var(--zc-img-self);
    width: var(--zc-img-w);
    height: auto;
    margin-bottom: var(--zc-img-mb);
    border-radius: var(--zc-img-radius);
  }

  .zcert__card-title {
    margin: 0 0 var(--zc-t-mb);
    font-family: var(--zc-b-font);
    font-size: var(--zc-t-size);
    font-weight: var(--zc-t-weight);
    line-height: var(--zc-t-lh);
    letter-spacing: var(--zc-t-ls);
    text-transform: var(--zc-t-tt);
    color: var(--zc-t-color);
  }

  .zcert__card-text {
    font-family: var(--zc-b-font);
    font-size: var(--zc-x-size);
    font-weight: var(--zc-x-weight);
    line-height: var(--zc-x-lh);
    letter-spacing: var(--zc-x-ls);
    color: var(--zc-x-color);
  }

  .zcert__card-text > * {
    margin: 0;
  }

  .zcert__card-text > * + * {
    margin-top: 0.7em;
  }

  .zcert__card-text p:empty {
    display: none;
  }

  /* ================= Móvil ================= */
  @media screen and (max-width: {{ bp_max }}px) {
    .zcert-{{ section.id }} {
      --zc-max-w: none;
      --zc-pt: {{ s.padding_top_m }}px;
      --zc-pb: {{ s.padding_bottom_m }}px;
      --zc-pl: {{ s.padding_left_m }}px;
      --zc-pr: {{ s.padding_right_m }}px;

      --zc-layout-gap: 0px;

      --zc-h-size: {{ s.heading_size_m }}px;
      --zc-h-lh: {{ s.heading_line_height_m | divided_by: 100.0 }};
      --zc-h-ls: {{ s.heading_letter_spacing_m }}px;
      --zc-h-align: {{ s.heading_align_m }};
      --zc-h-max-w: {{ s.heading_max_width_m }}%;
      --zc-h-mb: {{ s.heading_margin_bottom_m }}px;

      --zc-sub-size: {{ s.sub_size_m }}px;
      --zc-sub-mt: {{ s.sub_margin_top_m }}px;
      --zc-sub-max-w: {{ s.sub_max_width_m }}%;

      --zc-cards-cols: {{ cols_tpl_m }};
      --zc-col-gap: {{ s.col_gap_m }}px;
      --zc-row-gap: {{ s.row_gap_m }}px;

      --zc-card-radius: {{ s.card_radius_m }}px;
      --zc-card-px: {{ s.card_padding_x_m }}px;
      --zc-card-py: {{ s.card_padding_y_m }}px;
      --zc-card-min-h: {{ s.card_min_height_m }}px;
      --zc-card-align: {{ s.card_align_m }};

      --zc-img-w: {{ s.image_width_m }}px;
      --zc-img-mb: {{ s.image_margin_bottom_m }}px;
      --zc-img-self: {{ img_self_m }};

      --zc-t-size: {{ s.title_size_m }}px;
      --zc-t-mb: {{ s.title_margin_bottom_m }}px;

      --zc-x-size: {{ s.text_size_m }}px;
      --zc-x-lh: {{ s.text_line_height_m | divided_by: 100.0 }};
    }

    /* En móvil siempre en vertical: el título arriba y las tarjetas debajo,
       sea cual sea el orden elegido para PC. */
    .zcert-{{ section.id }} .zcert__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .zcert-{{ section.id }} .zcert__head {
      order: 0;
      margin-bottom: var(--zc-h-mb);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zcert-{{ section.id }} {
      --zc-anim: 1ms;
      --zc-card-lift: 0px;
    }
  }
{%- endstyle -%}

<div class="zcert zcert-{{ section.id }}"{% if s.anchor_id != blank %} id="{{ s.anchor_id | handle }}"{% endif %}>
  <div class="zcert__inner">
    <div class="zcert__layout zcert__layout--{{ s.layout_d }}">
      {%- if s.heading != blank or s.sub != blank -%}
        <div class="zcert__head">
          {%- if s.heading != blank -%}
            <{{ s.heading_tag }} class="zcert__heading">{{ s.heading | newline_to_br }}</{{ s.heading_tag }}>
          {%- endif -%}
          {%- if s.sub != blank -%}
            <div class="zcert__sub">{{ s.sub }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="zcert__cards">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign tag = 'div'
            if b.link != blank
              assign tag = 'a'
            endif
          -%}
          <{{ tag }}
            class="zcert__card"
            {% if b.link != blank %}
              href="{{ b.link }}"
              {% if b.new_tab %}target="_blank" rel="noopener"{% endif %}
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if b.image != blank -%}
              <img
                class="zcert__card-img"
                src="{{ b.image | image_url: width: 400 }}"
                srcset="
                  {{ b.image | image_url: width: 200 }} 200w,
                  {{ b.image | image_url: width: 400 }} 400w
                "
                sizes="{{ s.image_width_d }}px"
                width="{{ b.image.width }}"
                height="{{ b.image.height }}"
                alt="{{ b.image.alt | default: b.title | escape }}"
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}

            {%- if b.title != blank -%}
              <{{ s.title_tag }} class="zcert__card-title">{{ b.title }}</{{ s.title_tag }}>
            {%- endif -%}

            {%- if b.text != blank -%}
              <div class="zcert__card-text">{{ b.text }}</div>
            {%- endif -%}
          </{{ tag }}>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Certificados de calidad",
  "tag": "section",
  "class": "section-zcert",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Título"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Título",
      "info": "Enter para forzar un salto de línea. Envuelve una palabra en <em>así</em> para el acento.",
      "default": "Certificados Internacionales de Calidad"
    },
    {
      "type": "richtext",
      "id": "sub",
      "label": "Texto bajo el título",
      "info": "Opcional. Déjalo vacío para que no aparezca."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Etiqueta HTML del título (SEO)",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "div", "label": "div (sin peso SEO)" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "title_tag",
      "label": "Etiqueta HTML del nombre del certificado",
      "options": [
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "div", "label": "div (sin peso SEO)" }
      ],
      "default": "h3"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Ancla de la sección",
      "info": "Opcional. Si escribes 'certificados' podrás enlazar aquí con #certificados."
    },

    {
      "type": "header",
      "content": "Diseño general"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "mobile_breakpoint",
      "min": 480,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "label": "Punto de cambio a móvil",
      "default": 750
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 0,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Ancho máximo del contenido",
      "info": "0 = ancho completo.",
      "default": 1500
    },
    {
      "type": "select",
      "id": "layout_d",
      "label": "Disposición — PC",
      "options": [
        { "value": "side", "label": "Título a la izquierda, tarjetas a la derecha" },
        { "value": "right", "label": "Título a la derecha, tarjetas a la izquierda" },
        { "value": "stacked", "label": "Título arriba, tarjetas debajo" }
      ],
      "default": "side"
    },
    {
      "type": "range",
      "id": "head_width_d",
      "min": 15,
      "max": 70,
      "step": 1,
      "unit": "%",
      "label": "Ancho de la columna del título — PC",
      "info": "Solo con el título al lado de las tarjetas.",
      "default": 32
    },
    {
      "type": "range",
      "id": "layout_gap_d",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Separación entre el título y las tarjetas — PC",
      "default": 60
    },
    {
      "type": "select",
      "id": "head_valign_d",
      "label": "Posición vertical del título — PC",
      "info": "Solo con el título al lado de las tarjetas.",
      "options": [
        { "value": "start", "label": "Arriba" },
        { "value": "center", "label": "Centro" },
        { "value": "end", "label": "Abajo" }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "transition_ms",
      "min": 0,
      "max": 900,
      "step": 25,
      "unit": "ms",
      "label": "Duración de las transiciones",
      "default": 250
    },
    {
      "type": "range",
      "id": "padding_top_d",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding superior — PC",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_d",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior — PC",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_left_d",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding izquierdo — PC",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_right_d",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding derecho — PC",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_m",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding superior — Móvil",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_m",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding inferior — Móvil",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_left_m",
      "min": 0,
      "max": 80,
